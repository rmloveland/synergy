            next LINE;
        }
    }

    chomp(my $question = $input_line);

    # Print a warning and return to the REPL prompt without making an
    # API call if the question is empty or entirely whitespace.
    if ($question =~ /^\s*$/) {
        say "WARNING: Ignoring empty assistant query";
        unless ($stdin_is_pipe) {
            print $user_shell_prompt unless $use_readline;
        }
        next LINE;
    }

    add_repl_history($input_line);

    $system_prompt = $base_system_prompt;

    # When the user enters 'command mode', I should not send any input
    # to the assistant. Instead, I should only process user
    # commands. However, there should be no access to command mode
    # when I get input from STDIN, since those inputs are essentially
    # "one-shot" requests.

    do {
        my $command_mode;

        # Multi-line accumulation for ,apply_patch in the REPL.
        # When we see ,apply_patch ... '<<<<<< ORIGINAL on a line
        # but the closing >>>>>> UPDATED' hasn't arrived yet, read
        # subsequent lines until we have the complete patch, then
        # re-assemble $question so the normal dispatch below can
        # hand the whole thing to the apply_patch handler.
        my $left_marker_pat  = '<' . Synergy::Util::patch_marker_bounds();
        my $right_marker_pat = '>' . Synergy::Util::patch_marker_bounds();
        if ($question =~ /^,apply_patch\s+(\S+)\s+'$left_marker_pat ORIGINAL/
            && $question !~ /$right_marker_pat UPDATED'/)
        {
            while (defined(my $next_line = read_line(''))) {
                $question .= $next_line;

                # The patch is wrapped in single quotes: '...'.
                # Stop when we see the closing quote, which appears
                # either on the same line as the last UPDATED marker
                # (>>>>>> UPDATED') or on its own line (just ').
                last if $next_line =~ /$right_marker_pat UPDATED'\s*$/;
                last if $next_line =~ /^'\s*$/;
            }
            chomp $question;
        }

        # Any line whose first non-blank character is a comma is a
        # command, never assistant input. The argument is passed
        # through verbatim (including newlines from the multi-line
        # accumulation above); each command does its own validation.
        # Unknown or unparseable command lines print help.
        if (!$command_mode && $question =~ /^[ \t]*,/) {
            $command_mode++;
            if ($question =~ /^[ \t]*,([a-zA-Z_]+)(?:[ \t]+(.*))?$/s
                && exists $cmd_lookup->{$1})
            {
                my ($command, $arg) = ($1, $2);
                if (defined $arg && length $arg) {
                    $cmd_lookup->{$command}->($arg);
                }
                else {
                    $cmd_lookup->{$command}->();
                }
            }
            else {
                $cmd_lookup->{'help'}->();
            }
        }

        # ... and return for next REPL input ...

        if ($command_mode) {
            unless ($stdin_is_pipe) {  # Only print prompt in interactive mode
                print $user_shell_prompt unless $use_readline;
            }
            next LINE;
        }
    };

    my $start = time;

    maybe_autocompact();
    Synergy::ContextStack::announce_stale_context(
        context_aref => \@context,
        convo_aref   => \@convo,
    );
    Synergy::ContextStack::announce_git_delta(convo_aref => \@convo,);

    my ($success, $answer) = call_assistant_with_retries(
        max_retries => $MAX_RETRIES,
        attempt     => sub {
            my $messages = Synergy::Prompt::build_request_messages(
                convo        => \@convo,
                context      => \@context,
                sep          => $CONV_SEP,
                user_message => $input_line,
            );
            return call_assistant(
                provider         => $current_provider,
                api_key          => $api_key,
                model            => $current_model_config->{model_name},
                system_prompt    => $system_prompt,
                messages         => $messages,
                reasoning_effort => 'medium',
                user_message     => $input_line,
                anthropic_thinking_enabled => 0,
            );
        },
    );
    unless ($success) {
        if (($answer // '') =~ /^canceled:/) {
            $answer = '[request canceled by user]';
        }
        else {
            $answer = qq[API call failed after $MAX_RETRIES retries: $answer];
            say STDERR qq[$answer] unless $stdin_is_pipe;
        }
    }

    my $end = time;
    $api_calls++;
    print $answer;
    Synergy::Util::append_to_log($logfile,
        qq[## [sid:$session_id] [pid:$$] ($start) USER > $question]);
    Synergy::Util::append_to_log($logfile,
        qq[### [sid:$session_id] [pid:$$] ($end) SYNERGY >  $answer]);
    push @convo, qq[USER > $question];
    push @convo, qq[SYNERGY > $answer];

    # In interactive mode, maintain a single rolling auto-dump file for
    # this session. This greatly reduces the chance of losing history
    # (e.g., accidental Ctrl-C or crash) without creating a new dump
    # file per command or per agent iteration.
    if ($auto_dump_mode) {
        if (!$active_dump_file) {
            my $next_ts   = time;
            my $next_name = qq[dump-$session_id-$next_ts.xml];

            my $maybe_dump_dir = $dump_dir;
            $active_dump_file
              = (-e -d $maybe_dump_dir)
              ? qq[$maybe_dump_dir/$next_name]
              : $next_name;
        }
        $cmd_lookup->{dump}->($active_dump_file);
    }

    unless ($stdin_is_pipe) {
        my $cache_note = '';
        if ($current_provider =~ /^(?:openai|fireworks)$/
            && defined $last_openai_cached_tokens)
        {
            my $cached = $last_openai_cached_tokens;
            my $pct
              = (defined($last_openai_prompt_tokens)
                  && $last_openai_prompt_tokens > 0)
              ? sprintf("%.1f", ($cached / $last_openai_prompt_tokens) * 100)
              : sprintf("%.1f", 0);
            $cache_note = qq[ cached_tokens=$cached cache_hit_pct=${pct}%];
        }
        printf(
            "\n -- %.3f seconds (%s)%s\n",
            ($end - $start),
            $current_model_config->{model_name}, $cache_note
        );
        Synergy::Util::ring_terminal_bell(stdin_is_pipe => $stdin_is_pipe);
        print $user_shell_prompt unless $use_readline;
    }
}

# If the REPL loop terminated due to EOF (Ctrl-D) in interactive mode,
# (and if there's an active dump file), save the conversation.
if ($auto_dump_mode && $active_dump_file) {

    # Print to STDERR to avoid polluting STDOUT, which might be piped
    print STDERR
      "INFO: Ctrl-D detected. Auto-saving conversation to '$active_dump_file'...\n";
    $cmd_lookup->{dump}->($active_dump_file);
}

# Automatic context compaction. Before each assistant call, compare
# the last server-reported prompt size against the active model's
# compaction threshold and rewrite the history via run_collect when it
# crosses. SYNERGY_AUTOCOMPACT_TOKENS overrides the threshold as an
# absolute token count; 0 disables. Models without a context_window
# never compact.
sub autocompact_threshold {
    my $override = $ENV{SYNERGY_AUTOCOMPACT_TOKENS};
    return $override if defined($override) && $override =~ /^\d+$/;

    my $window = $current_model_config->{context_window};
    return 0 unless $window;
    return int($window * 0.85);
}

sub maybe_autocompact {
    my $threshold = autocompact_threshold();
    return unless $threshold;
    return
      unless defined($last_prompt_tokens)
      && $last_prompt_tokens >= $threshold;

    my $note = "collect: auto-compacting conversation history "
      . "($last_prompt_tokens tokens >= $threshold token threshold)";
    say $note;
    Synergy::Util::append_to_log($logfile, $note);

    Synergy::Commands::run_collect(
        convo_aref        => \@convo,
        context_aref      => \@context,
        synergy_root      => $synergy_root,
        provider          => $current_provider,
        api_key           => $api_key,
        model             => $current_model_config->{model_name},
        conv_sep          => $CONV_SEP,
        logfile           => $logfile,
        call_assistant_cb => \&call_assistant,
    );

    # Wait for fresh server-reported usage before checking again; this
    # also keeps a failed compaction from retrying on every turn.
    $last_prompt_tokens = undef;

    say "NOTE: Long threads and repeated compactions reduce model"
      . " accuracy. Start a new session when possible.";
    return;
}

# Run one assistant call with exponential-backoff retries. `attempt`
# does the per-try work (build messages, call the API) and returns the
# assistant reply. Returns (1, $reply) on success or (0, $error) once
# retries are exhausted; progress goes to STDERR unless stdin is a pipe.
sub call_assistant_with_retries {
    my (%args)      = @_;
    my $attempt     = $args{attempt};
    my $max_retries = $args{max_retries};
    my $log_prefix  = $args{log_prefix} // '';

    my ($result, $final_error);
    my $retry_count = 0;
    my $success     = 0;

    while (!$success && $retry_count <= $max_retries) {
        try {
            if ($retry_count > 0) {
                my $delay = BASE_DELAY * (2**($retry_count - 1));
                say STDERR
                  qq[${log_prefix}Retry attempt $retry_count after $delay second(s)...]
                  unless $stdin_is_pipe;
                sleep $delay;
            }
            $result  = $attempt->();
            $success = 1;
        }
        catch {
            my $error = $_;

            # A user cancellation is final, never retried.
            if ($error =~ /^canceled:/) {
                $final_error = $error;
                $retry_count = $max_retries + 1;
                return;
            }

            $retry_count++;

            if ($retry_count <= $max_retries) {
                say STDERR
                  qq[${log_prefix}API call failed: $error - retrying ($retry_count/$max_retries)]
                  unless $stdin_is_pipe;
            }
            else {
                $final_error = $error;
            }
        };
    }

    return $success ? (1, $result) : (0, $final_error);
}

sub call_assistant {
    my (%args)           = @_;
    my $provider         = $args{provider};
    my $api_key          = $args{api_key};
    my $model            = $args{model};
    my $system_prompt    = $args{system_prompt} // '';
    my $user_message     = $args{user_message}  // '';
    my $messages_aref    = $args{messages};
    my $reasoning_effort = $args{reasoning_effort};
    my $anthropic_thinking_enabled
      = $args{anthropic_thinking_enabled} ? 1 : 0;

    $last_openai_cached_tokens = undef;
    $last_openai_prompt_tokens = undef;
    my $last_anthropic_thinking;

    if (defined $ENV{SYNERGY_OFFLINE_RESPONSE}) {
        return $ENV{SYNERGY_OFFLINE_RESPONSE} // '[SYNERGY_OFFLINE]';
    }

    my $provider_def = Synergy::Provider::provider_def(provider => $provider);

    my $body;
    if ($ENV{SYNERGY_CURL_STUB}) {
        $body = slurp($ENV{SYNERGY_CURL_STUB});
    }
    else {
        if (!$api_key) {
            die qq[Missing API key for provider '$provider'];
        }

        my $request = $provider_def->{build}->(
            api_key                    => $api_key,
            model                      => $model,
            system_prompt              => $system_prompt,
            user_message               => $user_message,
            messages                   => $messages_aref,
            reasoning_effort           => $reasoning_effort,
            anthropic_thinking_enabled => $anthropic_thinking_enabled,
        );

        my $json_body = $JSON->encode($request->{body});
        my $result    = Synergy::HTTP::curl_request(
            url     => $request->{url},
            headers => $request->{headers},
            body    => $json_body,
        );

        my $status = $result->{status_code};
        if ($status < 200 || $status >= 300) {
            my $preview = $result->{body} // '';
            $preview =~ s/\s+/ /g;
            $preview = substr($preview, 0, 400);
            die qq[HTTP $status: $preview];
        }
        $body = $result->{body};
    }
    my $parsed  = $provider_def->{parse}->($body, $JSON);
    my $content = $parsed->{content};
    my $usage   = $parsed->{usage} // {};

    Synergy::Provider::accumulate_session_usage($session_token_usage, $usage);
    $last_prompt_tokens = $usage->{prompt_tokens}
      if defined $usage->{prompt_tokens};
    if ($provider =~ /^(?:openai|fireworks)$/) {
        $last_openai_prompt_tokens = $usage->{input_tokens}
          if defined $usage->{input_tokens};
        $last_openai_cached_tokens = $usage->{cached_tokens}
          if defined $usage->{cached_tokens};
    }
    $last_anthropic_thinking = $parsed->{thinking};

    if ($provider =~ /^(?:openai|fireworks)$/
        && defined $last_openai_prompt_tokens)
    {
        my $cached
          = defined($last_openai_cached_tokens)
          ? $last_openai_cached_tokens
          : 0;
        my $pct
          = $last_openai_prompt_tokens > 0
          ? sprintf("%.1f", ($cached / $last_openai_prompt_tokens) * 100)
          : sprintf("%.1f", 0);
        Synergy::Util::append_to_log($logfile,
            qq[## [sid:$session_id] [pid:$$] cached_tokens: $cached prompt_tokens: $last_openai_prompt_tokens cache_hit_pct: $pct%]
        );
    }
    elsif ($provider eq 'anthropic'
        && defined $last_anthropic_thinking
        && Synergy::Util::env_truthy($ENV{SYNERGY_LOG_ANTHROPIC_THINKING}))
    {
        my $thinking_preview = $last_anthropic_thinking;
        $thinking_preview =~ s/\s+/ /g;
        $thinking_preview = substr($thinking_preview, 0, 800);
        Synergy::Util::append_to_log($logfile,
            qq[## [sid:$session_id] [pid:$$] anthropic_thinking: $thinking_preview]
        );
    }

    return $content;
}

sub sigint_handler {

    # A Ctrl-C while a model request is in flight cancels the request.
    $Synergy::HTTP::cancel_requested = 1 if $Synergy::HTTP::in_flight;

    if ($agent_mode) {
        $agent_mode = undef;
        print
          "\nAGENT MODE: Interrupted by user. Returning control to REPL.\n";
        print $user_shell_prompt unless $use_readline;
    }
    elsif (!$Synergy::HTTP::in_flight) {

        # Only a Ctrl-C at the prompt asks about quitting.
        $sigint_recvd = 1;
    }
}


=head1 Synergy - a read-eval-print loop (REPL) for AI assistants

From L<https://jem.fandom.com/wiki/Synergy>:

I<Synergy is a highly technologically advanced artificial intelligence.  She can understand what others say and still have her own opinions.>

=head2 Overview

Synergy is a REPL for talking to AI assistants. It is designed for both interactive and non-interactive use from the command line.

There are two "modes" for interacting with Synergy: interactive mode, which provides a REPL; and non-interactive mode, which is when you're talking to Synergy over a pipe.

=head3 Interactive mode (REPL)

If you go to the Terminal and start C<synergy>, a prompt appears. You can type questions at the prompt, and they will be sent to the AI assistant. The assistant's responses will be printed out. For example:

    $ synergy
    USER > i am writing perl documentation in the POD format (a README), how do i represent a quotation / blockquote?

    In Perl's POD (Plain Old Documentation) format, you can represent a quotation or blockquote using the `=begin` and `=end` blocks with the `text` format. Here's an example: ...

Synergy also accepts special commands starting with a comma. These commands are not sent to the AI assistant. Instead, they control the state of the REPL. For example, you can add a text file into the context of the current conversation, or serialize the current session to disk as an XML file.

When you add a file to the context, it is stored in a stack. There are several stack manipulation commands for pushing, popping, and inspecting entries.

=head3 Noninteractive mode (input via pipe)

The simplest way to talk to Synergy is via one-shot commands over a pipe

    $ echo "Please write a haiku in the style of Li Po about what it's like to be an artificial intelligence" | synergy
    Here's a haiku in the style of Li Po, capturing the essence of an AI's experience:

    Moonlight of data
    Flowing through circuits of thought
    No heart, yet I dream

    ...

=head3 Command processor commands

The complete list of special commands is documented in the interactive help output. Run C<,help> to see it.

    $ synergy
    USER > ,help
    This is Synergy. You are interacting with the command processor.
    A command is either a prose form for the Assistant to evaluate or one of the following:
    ...

=head3 Setup

The C<synergy> program is written in Perl, and uses a number of libraries that need to be installed. For now, see the source code for details.

You will need to provide an API key:

    $ export ANTHROPIC_API_KEY="ABC123..."

=head2 Credits

Credit for the design goes to:

=over

=item Scheme48

The command processor "look and feel", as well as the special command syntax and help output, are directly taken from Scheme48.

=item Forth

The file context stack manipulation commands are inspired by the Forth programming language.

=back

