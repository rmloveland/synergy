    return $uuid_generator ? $uuid_generator->create_str() : simple_uuid();
}

sub simple_uuid {
    return join('-',
        sprintf("%08x",     int(rand(0xffffffff))),
        sprintf("%04x",     int(rand(0xffff))),
        sprintf("%04x",     int(rand(0xffff))),
        sprintf("%04x",     int(rand(0xffff))),
        sprintf("%04x%08x", int(rand(0xffff)), int(rand(0xffffffff))),
    );
}

sub env_truthy {
    my ($value) = @_;
    return 0 unless defined $value;
    return 0 if $value =~ /^\s*$/;
    return 0 if $value =~ /^(?:0|false|no|off)\s*$/i;
    return 1;
}

