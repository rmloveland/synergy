# Decode bytes as strict UTF-8, or return undef so the caller can
# fall back to byte-oriented handling for binary content. Note
# Encode::decode with a check argument consumes its input; pass a
# copy.
sub decode_utf8_or_undef {
    my ($bytes) = @_;
    return undef unless defined $bytes;
    return
      scalar
      eval { Encode::decode('UTF-8', my $copy = $bytes, Encode::FB_CROAK); };
}

my %IMAGE_MIME = (
    jpg  => 'image/jpeg',
