sub add_repl_history {
    my ($line) = @_;

    return unless $use_readline && $readline_term;
    return unless defined $line;

    $line =~ s/\r?\n\z//;
    return if $line =~ /^\s*$/;

    $readline_term->addhistory($line);
}


