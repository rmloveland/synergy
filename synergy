sub read_line {
    my ($prompt) = @_;

    if ($use_readline && $readline_term) {
        my $line = $readline_term->readline(defined $prompt ? $prompt : '');
        return undef unless defined $line;
        return $line =~ /\n\z/ ? $line : $line . "\n";
    }

    return scalar <>;
}

sub prompted_read_line {
    my ($prompt) = @_;

    print $prompt if defined($prompt) && length($prompt) && !$use_readline;
    return read_line($use_readline ? $prompt : '');
