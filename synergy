package Synergy::Prompt;

use strict;
use warnings;

# Render the pushed file-context stack as one delimited user message,
# marked for provider prompt caching. Sentinel lines rather than
# markdown fences: pushed files routinely contain ``` themselves,
# which would close a fence early and spill file content into the
# surrounding message. The asymmetric BEGIN/END pair also makes a
# truncated request obvious when reading captures and logs.
#
# Image entries (pushed as `image: '/path'` placeholders) are carried
# as paths on the internal synergy_images tag; the provider builders
# read and base64-encode them at request time. Like
# synergy_cache_role, the tag must never be serialized into a body.
sub _context_message {
    my ($context_aref, $sep) = @_;

    my (@text_entries, @image_paths);
    for my $entry (@$context_aref) {
        if   ($entry =~ /^image: '(.+)'\z/) { push @image_paths,  $1 }
        else                                { push @text_entries, $entry }
    }

    my $context_content = join($sep, @text_entries);
    my $message         = <<"EOCONTEXTMSG";
Relevant file/context state:
----- BEGIN FILE CONTEXT -----
$context_content
----- END FILE CONTEXT -----
EOCONTEXTMSG

    my $msg = {
        role               => 'user',
        content            => $message,
        synergy_cache_role => 'context',
    };
    $msg->{synergy_images} = \@image_paths if @image_paths;
    return $msg;
}

sub _labeled_user_message {
    my (%args)  = @_;
    my $label   = $args{label}   // 'Message';
    my $content = $args{content} // '';

    my $message_text = qq[$label:\n$content];

    return {role => 'user', content => $message_text};
}

sub convo_entry_to_message {
    my (%args) = @_;
    my $entry = $args{entry};

    return unless defined $entry;

    if ($entry =~ /^USER >\s?(.*)\z/s) {
        return {role => 'user', content => $1,};
    }

    if ($entry =~ /^SYNERGY >\s?(.*)\z/s) {
        return {role => 'assistant', content => $1,};
    }

    return {role => 'user', content => $entry,};
}

# Append conversation history and mark the newest history message as
# an incremental cache point. The live prompt after it changes every
# turn, but this turn's history is next turn's byte-identical prefix,
# so a breakpoint here lets provider caches grow with the conversation.
sub _push_convo_messages {
    my ($messages_aref, $convo_aref) = @_;

    my $added = 0;
    for my $entry (@$convo_aref) {
        my $msg = convo_entry_to_message(entry => $entry,);
        next unless $msg;
        push @$messages_aref, $msg;
        $added++;
    }
    $messages_aref->[-1]{synergy_cache_role} = 'history' if $added;
    return;
}

# The one request builder for both chat and agent turns. The layout
# [context, history..., final turn message] is deliberately identical
# across modes: provider prompt caches are prefix matches, so any
# mode-specific content must ride in the final message, after the
# history cache breakpoint, or switching modes forks the cache and
# re-ingests the whole session.
sub build_request_messages {
    my (%args)       = @_;
    my $convo_aref   = $args{convo}        // [];
    my $context_aref = $args{context}      // [];
    my $sep          = $args{sep}          // "\n===\n";
    my $user_message = $args{user_message} // '';
    my $user_label   = $args{user_label};

    my @messages;

    # Stable content first: the pushed file context must precede the
    # growing conversation history or its cache entry is invalidated
    # on every turn.
    if (@$context_aref) {
        push @messages, _context_message($context_aref, $sep);
    }

    _push_convo_messages(\@messages, $convo_aref);

    push @messages,
      defined $user_label
      ? _labeled_user_message(label => $user_label, content => $user_message)
      : {role => 'user', content => $user_message,};

    return \@messages;
}

package Synergy::Provider;

use strict;
use warnings;
use Try::Tiny;
use JSON::PP;
use File::Slurp  qw(slurp);
use MIME::Base64 qw(encode_base64);

# Read and base64-encode the images tagged on a message via
# synergy_images. Returns (\@images, \@unavailable): each image is
# {mime, data}; unreadable paths land in @unavailable so the builder
# can degrade to a text placeholder and the request still succeeds
# (the dump-portability path: a loaded dump may name images that no
# longer exist).
sub _encoded_images {
    my ($paths_aref) = @_;
    my (@images, @unavailable);
    for my $path (@{$paths_aref // []}) {
        my $mime = Synergy::Util::image_mime_type($path);
        my $bytes
          = (defined $mime && -r $path) ? eval { slurp($path) } : undef;
        if (!defined $bytes) {
            warn qq[WARNING: image '$path' unreadable, sending placeholder\n];
            push @unavailable, $path;
            next;
        }
        push @images, {mime => $mime, data => encode_base64($bytes, '')};
    }
    return (\@images, \@unavailable);
}

sub _text_with_unavailable_images {
    my ($content, $unavailable_aref) = @_;
    return $content unless @{$unavailable_aref // []};
    return join("\n",
        $content, map {qq{[image '$_' unavailable]}} @$unavailable_aref);
}

# Parsers are pure: parse($body, $JSON) returns {content, usage,
# thinking}; the caller records usage and thinking as it sees fit.
sub provider_def {
    my (%args) = @_;
    my $provider = $args{provider};

    my %defs = (
        openai => {
            build => \&build_openai_request,
            parse => \&parse_openai_response,
        },
        anthropic => {
            build => \&build_anthropic_request,
            parse => \&parse_anthropic_response,
        },
        gemini => {
            build => \&build_gemini_request,
            parse => \&parse_gemini_response,
        },

        # Fireworks speaks the OpenAI chat-completions dialect; the
        # OpenAI parser's 'choices' branch handles its responses.
        fireworks => {
            build => \&build_fireworks_request,
            parse => \&parse_openai_response,
        },
    );

    die qq[Unknown provider '$provider'] unless $defs{$provider};
    return $defs{$provider};
}

sub build_openai_request {
    my (%args)           = @_;
    my $api_key          = $args{api_key};
    my $model            = $args{model};
    my $system_prompt    = $args{system_prompt} // '';
    my $user_message     = $args{user_message}  // '';
    my $messages_aref    = $args{messages};
    my $reasoning_effort = $args{reasoning_effort};

    my @input;
    if (length $system_prompt) {
        push @input, {role => 'system', content => $system_prompt};
    }
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};
            if ($msg->{synergy_images}) {
                my ($images, $unavailable)
                  = _encoded_images($msg->{synergy_images});
                my $text = _text_with_unavailable_images($msg->{content},
                    $unavailable);
                push @input, {
                    role    => $msg->{role},
                    content => [
                        (
                            map {
                                {
                                    type      => 'input_image',
                                    image_url =>
                                      qq[data:$_->{mime};base64,$_->{data}],
                                }
                            } @$images
                        ),
                        {type => 'input_text', text => $text},
                    ],
                };
                next;
            }
            push @input, {role => $msg->{role}, content => $msg->{content}};
        }
    }
    else {
        push @input, {role => 'user', content => $user_message};
    }

    my $prompt_cache_key = $ENV{SYNERGY_OPENAI_PROMPT_CACHE_KEY};
    if (!defined($prompt_cache_key) || $prompt_cache_key eq '') {
        $prompt_cache_key = qq[synergy:$model];
    }

    my $prompt_cache_retention = $ENV{SYNERGY_OPENAI_PROMPT_CACHE_RETENTION};
    $reasoning_effort = $ENV{SYNERGY_OPENAI_REASONING_EFFORT}
      if defined $ENV{SYNERGY_OPENAI_REASONING_EFFORT};
    $reasoning_effort = 'medium'
      unless defined($reasoning_effort) && length($reasoning_effort);
    if ($reasoning_effort !~ /^(?:low|medium|high)$/) {
        $reasoning_effort = 'medium';
    }

    my %body = (
        model     => $model,
        input     => \@input,
        reasoning => {effort => $reasoning_effort},
    );
    $body{prompt_cache_key} = $prompt_cache_key if length $prompt_cache_key;
    if (defined($prompt_cache_retention) && length($prompt_cache_retention)) {
        $body{prompt_cache_retention} = $prompt_cache_retention;
    }

    return {
        url     => 'https://api.openai.com/v1/responses',
        headers => [
            'Content-Type: application/json',
            'Authorization: Bearer ' . $api_key,
        ],
        body => \%body,
    };
}

sub build_fireworks_request {
    my (%args)        = @_;
    my $api_key       = $args{api_key};
    my $model         = $args{model};
    my $system_prompt = $args{system_prompt} // '';
    my $user_message  = $args{user_message}  // '';
    my $messages_aref = $args{messages};

    my @messages;
    if (length $system_prompt) {
        push @messages, {role => 'system', content => $system_prompt};
    }
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};
            if ($msg->{synergy_images}) {
                my ($images, $unavailable)
                  = _encoded_images($msg->{synergy_images});
                my $text = _text_with_unavailable_images($msg->{content},
                    $unavailable);
                push @messages, {
                    role    => $msg->{role},
                    content => [
                        (
                            map {
                                {
                                    type      => 'image_url',
                                    image_url => {
                                        url =>
                                          qq[data:$_->{mime};base64,$_->{data}]
                                    },
                                }
                            } @$images
                        ),
                        {type => 'text', text => $text},
                    ],
                };
                next;
            }
            push @messages,
              {role => $msg->{role}, content => $msg->{content}};
        }
    }
    else {
        push @messages, {role => 'user', content => $user_message};
    }

    # Fireworks' default completion budget is small; give long agent
    # replies room to finish.
    my $max_tokens = 16384;
    if (defined $ENV{SYNERGY_FIREWORKS_MAX_TOKENS}
        && $ENV{SYNERGY_FIREWORKS_MAX_TOKENS} =~ /^\d+$/)
    {
        $max_tokens = int($ENV{SYNERGY_FIREWORKS_MAX_TOKENS});
    }

    return {
        url     => 'https://api.fireworks.ai/inference/v1/chat/completions',
        headers => [
            'Content-Type: application/json',
            'Authorization: Bearer ' . $api_key,
        ],
        body => {
            model      => $model,
            messages   => \@messages,
            max_tokens => $max_tokens,
        },
    };
}

sub accumulate_session_usage {
    my ($session_token_usage_ref, $usage_href) = @_;
    return unless $session_token_usage_ref;
    return unless ref($session_token_usage_ref) eq 'HASH';
    return unless $usage_href && ref($usage_href) eq 'HASH' && %$usage_href;

    my $input_tokens  = $usage_href->{input_tokens}  // 0;
    my $output_tokens = $usage_href->{output_tokens} // 0;
    my $total_tokens
      = defined $usage_href->{total_tokens}
      ? $usage_href->{total_tokens}
      : ($input_tokens + $output_tokens);
    my $cached_tokens = $usage_href->{cached_tokens} // 0;

    $session_token_usage_ref->{input_tokens}  += $input_tokens;
    $session_token_usage_ref->{output_tokens} += $output_tokens;
    $session_token_usage_ref->{total_tokens}  += $total_tokens;
    $session_token_usage_ref->{cached_tokens} += $cached_tokens;
    return;
}

sub _extract_openai_content_and_usage {
    my ($data) = @_;

    my $content;

    if (exists $data->{output_text} && defined $data->{output_text}) {
        $content = $data->{output_text};
    }
    elsif (exists $data->{output} && ref($data->{output}) ne 'ARRAY') {
        die "OpenAI response malformed: expected 'output' to be array";
    }
    elsif (ref($data->{output}) eq 'ARRAY') {
        my @chunks;
        for my $item (@{$data->{output}}) {
            next unless ref($item) eq 'HASH';
            next unless ref($item->{content}) eq 'ARRAY';
            for my $part (@{$item->{content}}) {
                next unless ref($part) eq 'HASH';
                next unless defined $part->{text};
                if (   !defined($part->{type})
                    || $part->{type} eq 'output_text'
                    || $part->{type} eq 'text')
                {
                    push @chunks, $part->{text};
                }
            }
        }
        $content = join '', @chunks if @chunks;
    }
    elsif (ref($data->{choices}) eq 'ARRAY'
        && ref($data->{choices}[0]) eq 'HASH'
        && ref($data->{choices}[0]{message}) eq 'HASH'
        && defined $data->{choices}[0]{message}{content})
    {
        $content = $data->{choices}[0]{message}{content};
    }

    my $input_tokens;
    my $output_tokens;
    my $total_tokens;
    my $cached_tokens;

    if ($data->{usage} && exists $data->{usage}{prompt_tokens}) {
        $input_tokens = $data->{usage}{prompt_tokens};
    }
    elsif ($data->{usage} && exists $data->{usage}{input_tokens}) {
        $input_tokens = $data->{usage}{input_tokens};
    }

    if ($data->{usage} && exists $data->{usage}{completion_tokens}) {
        $output_tokens = $data->{usage}{completion_tokens};
    }
    elsif ($data->{usage} && exists $data->{usage}{output_tokens}) {
        $output_tokens = $data->{usage}{output_tokens};
    }

    if ($data->{usage} && exists $data->{usage}{total_tokens}) {
        $total_tokens = $data->{usage}{total_tokens};
    }
    elsif (defined($input_tokens) && defined($output_tokens)) {
        $total_tokens = $input_tokens + $output_tokens;
    }

    if (   $data->{usage}
        && $data->{usage}{prompt_tokens_details}
        && exists $data->{usage}{prompt_tokens_details}{cached_tokens})
    {
        $cached_tokens = $data->{usage}{prompt_tokens_details}{cached_tokens};
    }
    elsif ($data->{usage}
        && $data->{usage}{input_tokens_details}
        && exists $data->{usage}{input_tokens_details}{cached_tokens})
    {
        $cached_tokens = $data->{usage}{input_tokens_details}{cached_tokens};
    }

    my %usage;
    $usage{input_tokens}  = $input_tokens  if defined $input_tokens;
    $usage{output_tokens} = $output_tokens if defined $output_tokens;
    $usage{total_tokens}  = $total_tokens  if defined $total_tokens;
    $usage{cached_tokens} = $cached_tokens if defined $cached_tokens;

    # Total prompt size (OpenAI input counts include cached tokens);
    # drives the automatic compaction check.
    $usage{prompt_tokens} = $input_tokens if defined $input_tokens;

    return ($content, \%usage);
}

sub build_anthropic_request {
    my (%args)           = @_;
    my $api_key          = $args{api_key};
    my $model            = $args{model};
    my $system_prompt    = $args{system_prompt} // '';
    my $user_message     = $args{user_message}  // '';
    my $messages_aref    = $args{messages};
    my $thinking_enabled = $args{anthropic_thinking_enabled} ? 1 : 0;
    my %cache_control    = (type => 'ephemeral');

    if (Synergy::Util::env_truthy($ENV{SYNERGY_NO_THINKING})) {
        $thinking_enabled = 0;
    }

    if (defined $ENV{SYNERGY_ANTHROPIC_PROMPT_CACHE_TTL}
        && $ENV{SYNERGY_ANTHROPIC_PROMPT_CACHE_TTL} =~ /^(?:1h)$/)
    {
        $cache_control{ttl} = $ENV{SYNERGY_ANTHROPIC_PROMPT_CACHE_TTL};
    }

    my $max_tokens = $thinking_enabled ? 16384 : 8192;
    if (defined $ENV{SYNERGY_ANTHROPIC_MAX_TOKENS}
        && $ENV{SYNERGY_ANTHROPIC_MAX_TOKENS} =~ /^\d+$/)
    {
        $max_tokens = int($ENV{SYNERGY_ANTHROPIC_MAX_TOKENS});
    }

    my @messages;
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};

            # Messages tagged by the prompt builder ('context' block,
            # newest 'history' message) carry a cache breakpoint; the
            # live prompt after them stays a plain uncached string.
            # Image blocks precede the text block, so the breakpoint
            # on the final (text) block covers them in the cached
            # prefix.
            if ($msg->{synergy_cache_role} || $msg->{synergy_images}) {
                my (@blocks, $text);
                $text = $msg->{content};
                if ($msg->{synergy_images}) {
                    my ($images, $unavailable)
                      = _encoded_images($msg->{synergy_images});
                    push @blocks, map {
                        {
                            type   => 'image',
                            source => {
                                type       => 'base64',
                                media_type => $_->{mime},
                                data       => $_->{data},
                            },
                        }
                    } @$images;
                    $text
                      = _text_with_unavailable_images($text, $unavailable);
                }
                push @blocks,
                  {
                    type => 'text',
                    text => $text,
                    (
                        $msg->{synergy_cache_role}
                        ? (cache_control => {%cache_control})
                        : ()
                    ),
                  };
                push @messages, {role => $msg->{role}, content => \@blocks};
            }
            else {
                push @messages,
                  {role => $msg->{role}, content => $msg->{content}};
            }
        }
    }
    else {
        push @messages, {role => 'user', content => $user_message};
    }

    my %body
      = (model => $model, messages => \@messages, max_tokens => $max_tokens,);
    if (length $system_prompt) {
        $body{system} = [
            {
                type          => 'text',
                text          => $system_prompt,
                cache_control => \%cache_control,
            }
        ];
    }
    if ($thinking_enabled) {
        $body{thinking}      = {type   => 'adaptive'};
        $body{output_config} = {effort => 'high'};
    }

    return {
        url     => 'https://api.anthropic.com/v1/messages',
        headers => [
            'Content-Type: application/json',
            'x-api-key: ' . $api_key,
            'anthropic-version: 2023-06-01',
        ],
        body => \%body,
    };
}

sub build_gemini_request {
    my (%args)        = @_;
    my $api_key       = $args{api_key};
    my $model         = $args{model};
    my $system_prompt = $args{system_prompt} // '';
    my $user_message  = $args{user_message}  // '';
    my $messages_aref = $args{messages};

    my @contents;
    if (length $system_prompt) {
        push @contents,
          {role => 'user', parts => [{text => $system_prompt}],};
    }
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};

            my $gemini_role = $msg->{role} eq 'assistant' ? 'model' : 'user';
            if ($msg->{synergy_images}) {
                my ($images, $unavailable)
                  = _encoded_images($msg->{synergy_images});
                my $text = _text_with_unavailable_images($msg->{content},
                    $unavailable);
                push @contents, {
                    role  => $gemini_role,
                    parts => [
                        (
                            map {
                                {
                                    inline_data => {
                                        mime_type => $_->{mime},
                                        data      => $_->{data},
                                    }
                                }
                            } @$images
                        ),
                        {text => $text},
                    ],
                };
                next;
            }
            push @contents,
              {role => $gemini_role, parts => [{text => $msg->{content}}],};
        }
    }
    else {
        push @contents, {role => 'user', parts => [{text => $user_message}]};
    }

    my %body = (
        contents         => \@contents,
        generationConfig => {maxOutputTokens => 8192,},
    );

    my $url
      = 'https://generativelanguage.googleapis.com/v1beta/models/'
      . $model
      . ':generateContent?key='
      . $api_key;

    return {
        url     => $url,
        headers => ['Content-Type: application/json'],
        body    => \%body,
    };
}

sub parse_openai_response {
    my ($body, $JSON) = @_;
    my $data = decode_json_response($JSON, $body);
    my ($content, $usage) = _extract_openai_content_and_usage($data);
    die "OpenAI response missing content" unless defined $content;
    return {content => $content, usage => $usage};
}

sub parse_anthropic_response {
    my ($body, $JSON) = @_;
    my $data = decode_json_response($JSON, $body);
    my @text_chunks;
    my @thinking_chunks;

    my %usage_to_record;
    my $usage = $data->{usage};
    if ($usage && ref($usage) eq 'HASH') {

        # Anthropic's input_tokens is only the uncached remainder;
        # add the cache read and write counts so 'input' means the
        # full prompt, matching the other providers (and keeping the
        # ,tokens cache-hit percentage bounded at 100%).
        my $input_tokens = $usage->{input_tokens};
        if (defined $input_tokens) {
            $input_tokens += ($usage->{cache_read_input_tokens} // 0)
              + ($usage->{cache_creation_input_tokens} // 0);
        }
        my $output_tokens = $usage->{output_tokens};
        my $total_tokens
          = defined($input_tokens)
          && defined($output_tokens)
          ? ($input_tokens + $output_tokens)
          : undef;
        my $cached_tokens = $usage->{cache_read_input_tokens};

        $usage_to_record{input_tokens} = $input_tokens
          if defined $input_tokens;
        $usage_to_record{output_tokens} = $output_tokens
          if defined $output_tokens;
        $usage_to_record{total_tokens} = $total_tokens
          if defined $total_tokens;
        $usage_to_record{cached_tokens} = $cached_tokens
          if defined $cached_tokens;

        # Total prompt size; drives the automatic compaction check.
        $usage_to_record{prompt_tokens} = $input_tokens
          if defined $input_tokens;
    }

    if (ref($data->{content}) eq 'ARRAY') {
        for my $item (@{$data->{content}}) {
            next unless ref($item) eq 'HASH';

            if (   defined $item->{text}
                && defined($item->{type})
                && $item->{type} eq 'text')
            {
                push @text_chunks, $item->{text};
                next;
            }

            if (defined $item->{thinking}) {
                push @thinking_chunks, $item->{thinking};
            }

            if (ref($item->{summary}) eq 'ARRAY') {
                for my $summary_part (@{$item->{summary}}) {
                    next unless ref($summary_part) eq 'HASH';
                    next unless defined $summary_part->{text};
                    push @thinking_chunks, $summary_part->{text};
                }
            }
        }
    }
    elsif (!ref($data->{content}) && defined $data->{content}) {
        push @text_chunks, $data->{content};
    }

    my $content;
    if (@text_chunks) {
        $content = join('', @text_chunks);
    }
    elsif (@thinking_chunks) {
        $content = join('', @thinking_chunks);
    }
    elsif (defined $data->{completion}) {
        $content = $data->{completion};
    }

    die "Anthropic response missing content" unless defined $content;
    return {
        content  => $content,
        usage    => \%usage_to_record,
        thinking => (@thinking_chunks ? join('', @thinking_chunks) : undef),
    };
}

sub parse_gemini_response {
    my ($body, $JSON) = @_;
    my $data = decode_json_response($JSON, $body);

    my %usage_to_record;
    my $usage = $data->{usageMetadata};
    if ($usage && ref($usage) eq 'HASH') {
        my $input_tokens  = $usage->{promptTokenCount};
        my $output_tokens = $usage->{candidatesTokenCount};
        my $total_tokens  = $usage->{totalTokenCount};
        my $cached_tokens = $usage->{cachedContentTokenCount};

        $total_tokens = $input_tokens + $output_tokens
          if !defined($total_tokens)
          && defined($input_tokens)
          && defined($output_tokens);

        $usage_to_record{input_tokens} = $input_tokens
          if defined $input_tokens;
        $usage_to_record{output_tokens} = $output_tokens
          if defined $output_tokens;
        $usage_to_record{total_tokens} = $total_tokens
          if defined $total_tokens;
        $usage_to_record{cached_tokens} = $cached_tokens
          if defined $cached_tokens;

        # Total prompt size (promptTokenCount includes cached tokens);
        # drives the automatic compaction check.
        $usage_to_record{prompt_tokens} = $input_tokens
          if defined $input_tokens;
    }

    my $content = $data->{candidates}[0]{content}{parts}[0]{text};
    die "Gemini response missing content" unless defined $content;
    return {content => $content, usage => \%usage_to_record};
}

sub decode_json_response {
    my ($JSON, $body) = @_;
    my $data;
    try {
        $data = $JSON->decode($body);
    }
    catch {
        my $error   = $_;
        my $preview = $body // '';
        $preview =~ s/\s+/ /g;
        $preview = substr($preview, 0, 200);
        die qq[Failed to parse JSON response: $error (body: $preview)];
    };
    return $data;
}

package Synergy::HTTP;

use strict;
use warnings;
use File::Temp  qw(tempfile);
use File::Slurp qw/ slurp /;
use POSIX       qw(WNOHANG);
use Time::HiRes ();

# $in_flight is true while a curl child runs. The SIGINT handler sets
# $cancel_requested instead of its usual behavior; the poll loop below
# then kills curl and aborts the call with a 'canceled:' error, which
# the retry machinery treats as final rather than retryable.
our $in_flight        = 0;
our $cancel_requested = 0;

sub curl_request {
    my (%args)  = @_;
    my $url     = $args{url};
    my $headers = $args{headers} // [];
    my $body    = $args{body}    // '';

    my ($req_fh,  $req_file)  = tempfile('synergy_req_XXXX',  TMPDIR => 1);
    my ($err_fh,  $err_file)  = tempfile('synergy_err_XXXX',  TMPDIR => 1);
    my ($resp_fh, $resp_file) = tempfile('synergy_resp_XXXX', TMPDIR => 1);
    my ($code_fh, $code_file) = tempfile('synergy_code_XXXX', TMPDIR => 1);
    close $resp_fh;
    close $code_fh;

    print $req_fh $body;
    close $req_fh;
    close $err_fh;

    my @cmd = (
        'curl',         '--silent',  '--show-error', '--write-out',
        '%{http_code}', '--request', 'POST',         '--data-binary',
        "\@$req_file",  '--stderr',  $err_file,      '--output',
        $resp_file,
    );
    for my $header (@$headers) {
        push @cmd, '--header', $header;
    }
    push @cmd, $url;

    local $in_flight = 1;
    $cancel_requested = 0;

    my $pid = fork();
    die "ERROR: failed to fork for curl: $!" unless defined $pid;
    if ($pid == 0) {
        open STDOUT, '>', $code_file or die "redirect curl stdout: $!";
        exec {$cmd[0]} @cmd or die "exec curl failed: $!";
    }

    # Poll instead of blocking so Ctrl-C can cancel the request and an
    # interactive user sees a heartbeat instead of a frozen prompt.
    my $interactive = (-t STDOUT && -t STDERR) ? 1 : 0;
    my $started     = Time::HiRes::time();
    my $last_beat   = 0;
    my $beating     = 0;
    while (waitpid($pid, WNOHANG) == 0) {
        if ($cancel_requested) {
            kill 'TERM', $pid;
            waitpid($pid, 0);
            print STDERR "\r\033[K" if $beating;
            unlink $req_file, $resp_file, $err_file, $code_file;
            die "canceled: request interrupted by user\n";
        }

        my $elapsed = int(Time::HiRes::time() - $started);
        if ($interactive && $elapsed > $last_beat) {
            $last_beat = $elapsed;
            $beating   = 1;
            printf STDERR "\r[waiting for response... %ds]", $elapsed;
        }
        Time::HiRes::sleep(0.1);
    }
    my $exit_code = $? >> 8;
    print STDERR "\r\033[K" if $beating;

    my $http_code = slurp($code_file);
    my $stderr    = slurp($err_file);
    my $resp_body = slurp($resp_file);

    unlink $req_file, $resp_file, $err_file, $code_file;

    if ($exit_code != 0) {
        die qq[curl failed (exit $exit_code): $stderr];
    }

    $http_code //= '';
    $http_code =~ s/\s+//g;
    if ($http_code !~ /^\d+$/) {
        die qq[curl failed to return HTTP status code];
    }

    return {
        status_code => int($http_code),
        body        => $resp_body,
        stderr      => $stderr,
    };
}

package Synergy::Util;

use strict;
