);

# Single authority for "is this path an image": returns the MIME
# type for a known image extension, else undef.
sub image_mime_type {
    my ($path) = @_;
    return undef unless defined $path;
    my ($ext) = $path =~ /\.([A-Za-z0-9]+)\z/;
    return undef unless defined $ext;
    return $IMAGE_MIME{lc $ext};
