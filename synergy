package Synergy::Prompt;

use strict;
use warnings;

sub build_prompt_context {
    my (%args)       = @_;
    my $convo_aref   = $args{convo}   // [];
    my $context_aref = $args{context} // [];
    my $sep          = $args{sep}     // "\n===\n";

    my ($block_start, $block_end);
    $block_start = '```';
    $block_end   = '```';

    my ($convo_content, $context_content);
    $convo_content   = @$convo_aref   ? join($sep, @$convo_aref)   : '';
    $context_content = @$context_aref ? join($sep, @$context_aref) : '';

    return {
        convo_content   => $convo_content,
        context_content => $context_content,
        block_start     => $block_start,
        block_end       => $block_end,
    };
}

sub _labeled_user_message {
    my (%args)  = @_;
    my $label   = $args{label}   // 'Message';
    my $content = $args{content} // '';

    my $message_text = qq[$label:\n$content];

    return {role => 'user', content => $message_text};
}

sub convo_entry_to_message {
    my (%args) = @_;
    my $entry = $args{entry};

    return unless defined $entry;

    if ($entry =~ /^USER >\s?(.*)\z/s) {
        return {role => 'user', content => $1,};
    }

    if ($entry =~ /^SYNERGY >\s?(.*)\z/s) {
        return {role => 'assistant', content => $1,};
    }

    return {role => 'user', content => $entry,};
}

sub build_request_messages {
    my (%args)       = @_;
    my $convo_aref   = $args{convo}        // [];
    my $context_aref = $args{context}      // [];
    my $sep          = $args{sep}          // "\n===\n";
    my $user_message = $args{user_message} // '';

    my @messages;

    for my $entry (@$convo_aref) {
        my $msg = convo_entry_to_message(entry => $entry,);
        push @messages, $msg if $msg;
    }

    if (@$context_aref) {
        my $ctx = build_prompt_context(
            convo   => [],
            context => $context_aref,
            sep     => $sep,
        );

        my $context_message = <<"EOCONTEXTMSG";
Relevant file/context state:
$ctx->{block_start}
$ctx->{context_content}
$ctx->{block_end}
EOCONTEXTMSG
        push @messages,
          {
            role               => 'user',
            content            => $context_message,
            synergy_cache_role => 'context',
          };
    }

    push @messages, {role => 'user', content => $user_message,};

    return \@messages;
}

sub build_agent_request_messages {
    my (%args)           = @_;
    my $convo_aref       = $args{convo}            // [];
    my $context_aref     = $args{context}          // [];
    my $sep              = $args{sep}              // "\n===\n";
    my $task_description = $args{task_description} // '';
    my $cwd              = $args{cwd}              // '.';
    my $next_turn_prompt = $args{next_turn_prompt} // '';

    my @messages;

    my $environment_message = <<"EOENVMSG";
Working Directory: $cwd

Task:
$task_description
EOENVMSG
    push @messages,
      _labeled_user_message(
        label   => 'Agent task and environment',
        content => $environment_message,
      );

    if (@$context_aref) {
        my $ctx = build_prompt_context(
            convo   => [],
            context => $context_aref,
            sep     => $sep,
        );

        my $context_message = <<"EOCONTEXTMSG";
Relevant file/context state:
$ctx->{block_start}
$ctx->{context_content}
$ctx->{block_end}
EOCONTEXTMSG
        push @messages,
          {
            role               => 'user',
            content            => $context_message,
            synergy_cache_role => 'context',
          };
    }

    for my $entry (@$convo_aref) {
        my $msg = convo_entry_to_message(entry => $entry,);
        push @messages, $msg if $msg;
    }

    push @messages,
      _labeled_user_message(
        label   => 'Agent next turn',
        content => $next_turn_prompt,
      );

    return \@messages;
}

sub estimate_request_chars {
    my (%args)        = @_;
    my $messages      = $args{messages}      // [];
    my $system_prompt = $args{system_prompt} // '';
    my $chars         = length $system_prompt;

    for my $msg (@$messages) {
        next unless ref($msg) eq 'HASH';
        $chars += length($msg->{role}    // '');
        $chars += length($msg->{content} // '');
        $chars += 16;
    }

    return $chars;
}

package Synergy::Provider;

use strict;
use warnings;
use Try::Tiny;
use JSON::PP;

sub provider_def {
    my (%args)   = @_;
    my $provider = $args{provider};
    my $JSON     = $args{JSON};

    my $last_openai_cached_tokens_ref = $args{last_openai_cached_tokens_ref};
    my $last_openai_prompt_tokens_ref = $args{last_openai_prompt_tokens_ref};
    my $last_anthropic_thinking_ref   = $args{last_anthropic_thinking_ref};
    my $session_token_usage_ref       = $args{session_token_usage_ref};

    my %defs = (
        openai => {
            build => \&build_openai_request,
            parse => sub {
                my ($body) = @_;
                return parse_openai_response(
                    $body, $JSON,
                    $last_openai_prompt_tokens_ref,
                    $last_openai_cached_tokens_ref,
                    $session_token_usage_ref
                );
            },
        },
        anthropic => {
            build => \&build_anthropic_request,
            parse => sub {
                my ($body) = @_;
                return parse_anthropic_response($body, $JSON,
                    $last_anthropic_thinking_ref, $session_token_usage_ref);
            },
        },
        gemini => {
            build => \&build_gemini_request,
            parse => sub {
                my ($body) = @_;
                return parse_gemini_response($body, $JSON,
                    $session_token_usage_ref);
            },
        },
    );

    die qq[Unknown provider '$provider'] unless $defs{$provider};
    return $defs{$provider};
}

sub build_openai_request {
    my (%args)           = @_;
    my $api_key          = $args{api_key};
    my $model            = $args{model};
    my $system_prompt    = $args{system_prompt} // '';
    my $user_message     = $args{user_message}  // '';
    my $messages_aref    = $args{messages};
    my $reasoning_effort = $args{reasoning_effort};

    my @input;
    if (length $system_prompt) {
        push @input, {role => 'system', content => $system_prompt};
    }
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};
            push @input, {role => $msg->{role}, content => $msg->{content}};
        }
    }
    else {
        push @input, {role => 'user', content => $user_message};
    }

    my $prompt_cache_key = $ENV{SYNERGY_OPENAI_PROMPT_CACHE_KEY};
    if (!defined($prompt_cache_key) || $prompt_cache_key eq '') {
        $prompt_cache_key = qq[synergy:$model];
    }

    my $prompt_cache_retention = $ENV{SYNERGY_OPENAI_PROMPT_CACHE_RETENTION};
    $reasoning_effort = $ENV{SYNERGY_OPENAI_REASONING_EFFORT}
      if defined $ENV{SYNERGY_OPENAI_REASONING_EFFORT};
    $reasoning_effort = 'medium'
      unless defined($reasoning_effort) && length($reasoning_effort);
    if ($reasoning_effort !~ /^(?:low|medium|high)$/) {
        $reasoning_effort = 'medium';
    }

    my %body = (
        model     => $model,
        input     => \@input,
        reasoning => {effort => $reasoning_effort},
    );
    $body{prompt_cache_key} = $prompt_cache_key if length $prompt_cache_key;
    if (defined($prompt_cache_retention) && length($prompt_cache_retention)) {
        $body{prompt_cache_retention} = $prompt_cache_retention;
    }

    return {
        url     => 'https://api.openai.com/v1/responses',
        headers => [
            'Content-Type: application/json',
            'Authorization: Bearer ' . $api_key,
        ],
        body => \%body,
    };
}

sub _accumulate_session_usage {
    my ($session_token_usage_ref, $usage_href) = @_;
    return unless $session_token_usage_ref;
    return unless ref($session_token_usage_ref) eq 'HASH';
    return unless $usage_href && ref($usage_href) eq 'HASH' && %$usage_href;

    my $input_tokens  = $usage_href->{input_tokens}  // 0;
    my $output_tokens = $usage_href->{output_tokens} // 0;
    my $total_tokens
      = defined $usage_href->{total_tokens}
      ? $usage_href->{total_tokens}
      : ($input_tokens + $output_tokens);
    my $cached_tokens = $usage_href->{cached_tokens} // 0;

    $session_token_usage_ref->{input_tokens}  += $input_tokens;
    $session_token_usage_ref->{output_tokens} += $output_tokens;
    $session_token_usage_ref->{total_tokens}  += $total_tokens;
    $session_token_usage_ref->{cached_tokens} += $cached_tokens;
    return;
}

sub _extract_openai_content_and_usage {
    my (
        $data,
        $last_openai_prompt_tokens_ref,
        $last_openai_cached_tokens_ref,
        $session_token_usage_ref
    ) = @_;

    my $content;

    if (exists $data->{output_text} && defined $data->{output_text}) {
        $content = $data->{output_text};
    }
    elsif (exists $data->{output} && ref($data->{output}) ne 'ARRAY') {
        die "OpenAI response malformed: expected 'output' to be array";
    }
    elsif (ref($data->{output}) eq 'ARRAY') {
        my @chunks;
        for my $item (@{$data->{output}}) {
            next unless ref($item) eq 'HASH';
            next unless ref($item->{content}) eq 'ARRAY';
            for my $part (@{$item->{content}}) {
                next unless ref($part) eq 'HASH';
                next unless defined $part->{text};
                if (   !defined($part->{type})
                    || $part->{type} eq 'output_text'
                    || $part->{type} eq 'text')
                {
                    push @chunks, $part->{text};
                }
            }
        }
        $content = join '', @chunks if @chunks;
    }
    elsif (ref($data->{choices}) eq 'ARRAY'
        && ref($data->{choices}[0]) eq 'HASH'
        && ref($data->{choices}[0]{message}) eq 'HASH'
        && defined $data->{choices}[0]{message}{content})
    {
        $content = $data->{choices}[0]{message}{content};
    }

    $$last_openai_cached_tokens_ref = undef;
    $$last_openai_prompt_tokens_ref = undef;

    my $input_tokens;
    my $output_tokens;
    my $total_tokens;
    my $cached_tokens;

    if ($data->{usage} && exists $data->{usage}{prompt_tokens}) {
        $input_tokens = $data->{usage}{prompt_tokens};
    }
    elsif ($data->{usage} && exists $data->{usage}{input_tokens}) {
        $input_tokens = $data->{usage}{input_tokens};
    }

    if ($data->{usage} && exists $data->{usage}{completion_tokens}) {
        $output_tokens = $data->{usage}{completion_tokens};
    }
    elsif ($data->{usage} && exists $data->{usage}{output_tokens}) {
        $output_tokens = $data->{usage}{output_tokens};
    }

    if ($data->{usage} && exists $data->{usage}{total_tokens}) {
        $total_tokens = $data->{usage}{total_tokens};
    }
    elsif (defined($input_tokens) && defined($output_tokens)) {
        $total_tokens = $input_tokens + $output_tokens;
    }

    if (   $data->{usage}
        && $data->{usage}{prompt_tokens_details}
        && exists $data->{usage}{prompt_tokens_details}{cached_tokens})
    {
        $cached_tokens = $data->{usage}{prompt_tokens_details}{cached_tokens};
    }
    elsif ($data->{usage}
        && $data->{usage}{input_tokens_details}
        && exists $data->{usage}{input_tokens_details}{cached_tokens})
    {
        $cached_tokens = $data->{usage}{input_tokens_details}{cached_tokens};
    }

    $$last_openai_prompt_tokens_ref = $input_tokens if defined $input_tokens;
    $$last_openai_cached_tokens_ref = $cached_tokens
      if defined $cached_tokens;

    my %usage;
    $usage{input_tokens}  = $input_tokens  if defined $input_tokens;
    $usage{output_tokens} = $output_tokens if defined $output_tokens;
    $usage{total_tokens}  = $total_tokens  if defined $total_tokens;
    $usage{cached_tokens} = $cached_tokens if defined $cached_tokens;

    _accumulate_session_usage($session_token_usage_ref, \%usage);

    return $content;
}

sub build_anthropic_request {
    my (%args)           = @_;
    my $api_key          = $args{api_key};
    my $model            = $args{model};
    my $system_prompt    = $args{system_prompt} // '';
    my $user_message     = $args{user_message}  // '';
    my $messages_aref    = $args{messages};
    my $thinking_enabled = $args{anthropic_thinking_enabled} ? 1 : 0;
    my %cache_control    = (type => 'ephemeral');

    if (Synergy::Util::env_truthy($ENV{SYNERGY_NO_THINKING})) {
        $thinking_enabled = 0;
    }

    if (defined $ENV{SYNERGY_ANTHROPIC_PROMPT_CACHE_TTL}
        && $ENV{SYNERGY_ANTHROPIC_PROMPT_CACHE_TTL} =~ /^(?:1h)$/)
    {
        $cache_control{ttl} = $ENV{SYNERGY_ANTHROPIC_PROMPT_CACHE_TTL};
    }

    my $max_tokens = $thinking_enabled ? 16384 : 8192;
    if (defined $ENV{SYNERGY_ANTHROPIC_MAX_TOKENS}
        && $ENV{SYNERGY_ANTHROPIC_MAX_TOKENS} =~ /^\d+$/)
    {
        $max_tokens = int($ENV{SYNERGY_ANTHROPIC_MAX_TOKENS});
    }

    my @messages;
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};
            if (($msg->{synergy_cache_role} // '') eq 'context') {
                push @messages,
                  {
                    role    => $msg->{role},
                    content => [
                        {
                            type          => 'text',
                            text          => $msg->{content},
                            cache_control => {%cache_control},
                        }
                    ],
                  };
            }
            else {
                push @messages,
                  {role => $msg->{role}, content => $msg->{content}};
            }
        }
    }
    else {
        push @messages, {role => 'user', content => $user_message};
    }

    my %body
      = (model => $model, messages => \@messages, max_tokens => $max_tokens,);
    if (length $system_prompt) {
        $body{system} = [
            {
                type          => 'text',
                text          => $system_prompt,
                cache_control => \%cache_control,
            }
        ];
    }
    if ($thinking_enabled) {
        $body{thinking}      = {type   => 'adaptive'};
        $body{output_config} = {effort => 'high'};
    }

    return {
        url     => 'https://api.anthropic.com/v1/messages',
        headers => [
            'Content-Type: application/json',
            'x-api-key: ' . $api_key,
            'anthropic-version: 2023-06-01',
        ],
        body => \%body,
    };
}

sub build_gemini_request {
    my (%args)        = @_;
    my $api_key       = $args{api_key};
    my $model         = $args{model};
    my $system_prompt = $args{system_prompt} // '';
    my $user_message  = $args{user_message}  // '';
    my $messages_aref = $args{messages};

    my @contents;
    if (length $system_prompt) {
        push @contents,
          {role => 'user', parts => [{text => $system_prompt}],};
    }
    if ($messages_aref && ref($messages_aref) eq 'ARRAY') {
        for my $msg (@$messages_aref) {
            next unless ref($msg) eq 'HASH';
            next unless defined $msg->{role};
            next unless defined $msg->{content};

            my $gemini_role = $msg->{role} eq 'assistant' ? 'model' : 'user';
            push @contents,
              {role => $gemini_role, parts => [{text => $msg->{content}}],};
        }
    }
    else {
        push @contents, {role => 'user', parts => [{text => $user_message}]};
    }

    my %body = (
        contents         => \@contents,
        generationConfig => {maxOutputTokens => 8192,},
    );

    my $url
      = 'https://generativelanguage.googleapis.com/v1beta/models/'
      . $model
      . ':generateContent?key='
      . $api_key;

    return {
        url     => $url,
        headers => ['Content-Type: application/json'],
        body    => \%body,
    };
}

sub parse_openai_response {
    my (
        $body, $JSON,
        $last_openai_prompt_tokens_ref,
        $last_openai_cached_tokens_ref,
        $session_token_usage_ref
    ) = @_;
    my $data    = decode_json_response($JSON, $body);
    my $content = _extract_openai_content_and_usage(
        $data,
        $last_openai_prompt_tokens_ref,
        $last_openai_cached_tokens_ref,
        $session_token_usage_ref
    );
    die "OpenAI response missing content" unless defined $content;
    return $content;
}

sub parse_anthropic_response {
    my ($body, $JSON, $last_anthropic_thinking_ref, $session_token_usage_ref)
      = @_;
    my $data = decode_json_response($JSON, $body);
    my @text_chunks;
    my @thinking_chunks;

    $$last_anthropic_thinking_ref = undef
      if defined $last_anthropic_thinking_ref;

    my $usage = $data->{usage};
    if ($usage && ref($usage) eq 'HASH') {
        my $input_tokens  = $usage->{input_tokens};
        my $output_tokens = $usage->{output_tokens};
        my $total_tokens
          = defined($input_tokens)
          && defined($output_tokens)
          ? ($input_tokens + $output_tokens)
          : undef;
        my $cached_tokens = $usage->{cache_read_input_tokens};
        my %usage_to_record;

        $usage_to_record{input_tokens} = $input_tokens
          if defined $input_tokens;
        $usage_to_record{output_tokens} = $output_tokens
          if defined $output_tokens;
        $usage_to_record{total_tokens} = $total_tokens
          if defined $total_tokens;
        $usage_to_record{cached_tokens} = $cached_tokens
          if defined $cached_tokens;

        _accumulate_session_usage($session_token_usage_ref,
            \%usage_to_record);
    }

    if (ref($data->{content}) eq 'ARRAY') {
        for my $item (@{$data->{content}}) {
            next unless ref($item) eq 'HASH';

            if (   defined $item->{text}
                && defined($item->{type})
                && $item->{type} eq 'text')
            {
                push @text_chunks, $item->{text};
                next;
            }

            if (defined $item->{thinking}) {
                push @thinking_chunks, $item->{thinking};
            }

            if (ref($item->{summary}) eq 'ARRAY') {
                for my $summary_part (@{$item->{summary}}) {
                    next unless ref($summary_part) eq 'HASH';
                    next unless defined $summary_part->{text};
                    push @thinking_chunks, $summary_part->{text};
                }
            }
        }
    }
    elsif (!ref($data->{content}) && defined $data->{content}) {
        push @text_chunks, $data->{content};
    }

    my $content;
    if (@text_chunks) {
        $content = join('', @text_chunks);
    }
    elsif (@thinking_chunks) {
        $content = join('', @thinking_chunks);
    }
    elsif (defined $data->{completion}) {
        $content = $data->{completion};
    }

    if (@thinking_chunks && defined $last_anthropic_thinking_ref) {
        $$last_anthropic_thinking_ref = join('', @thinking_chunks);
    }

    die "Anthropic response missing content" unless defined $content;
    return $content;
}

sub parse_gemini_response {
    my ($body, $JSON, $session_token_usage_ref) = @_;
    my $data = decode_json_response($JSON, $body);

    my $usage = $data->{usageMetadata};
    if ($usage && ref($usage) eq 'HASH') {
        my $input_tokens  = $usage->{promptTokenCount};
        my $output_tokens = $usage->{candidatesTokenCount};
        my $total_tokens  = $usage->{totalTokenCount};
        my $cached_tokens = $usage->{cachedContentTokenCount};
        my %usage_to_record;

        $total_tokens = $input_tokens + $output_tokens
          if !defined($total_tokens)
          && defined($input_tokens)
          && defined($output_tokens);

        $usage_to_record{input_tokens} = $input_tokens
          if defined $input_tokens;
        $usage_to_record{output_tokens} = $output_tokens
          if defined $output_tokens;
        $usage_to_record{total_tokens} = $total_tokens
          if defined $total_tokens;
        $usage_to_record{cached_tokens} = $cached_tokens
          if defined $cached_tokens;

        _accumulate_session_usage($session_token_usage_ref,
            \%usage_to_record);
    }

    my $content = $data->{candidates}[0]{content}{parts}[0]{text};
    die "Gemini response missing content" unless defined $content;
    return $content;
}

sub decode_json_response {
    my ($JSON, $body) = @_;
    my $data;
    try {
        $data = $JSON->decode($body);
    }
    catch {
        my $error   = $_;
        my $preview = $body // '';
        $preview =~ s/\s+/ /g;
        $preview = substr($preview, 0, 200);
        die qq[Failed to parse JSON response: $error (body: $preview)];
    };
    return $data;
}

package Synergy::HTTP;

use strict;
use warnings;
use File::Temp  qw(tempfile);
use File::Slurp qw/ slurp /;

sub curl_request {
    my (%args)  = @_;
    my $url     = $args{url};
    my $headers = $args{headers} // [];
    my $body    = $args{body}    // '';

    my ($req_fh,  $req_file)  = tempfile('synergy_req_XXXX',  TMPDIR => 1);
    my ($err_fh,  $err_file)  = tempfile('synergy_err_XXXX',  TMPDIR => 1);
    my ($resp_fh, $resp_file) = tempfile('synergy_resp_XXXX', TMPDIR => 1);
    close $resp_fh;

    print $req_fh $body;
    close $req_fh;
    close $err_fh;

    my @cmd = (
        'curl',         '--silent',  '--show-error', '--write-out',
        '%{http_code}', '--request', 'POST',         '--data-binary',
        "\@$req_file",  '--stderr',  $err_file,      '--output',
        $resp_file,
    );
    for my $header (@$headers) {
        push @cmd, '--header', $header;
    }
    push @cmd, $url;

    open my $curl_fh, '-|', @cmd or die "ERROR: failed to execute curl: $!";
    binmode($curl_fh, ':raw');
    my $http_code = do { local $/; <$curl_fh> };
    close $curl_fh;
    my $exit_code = $? >> 8;

    my $stderr    = slurp($err_file);
    my $resp_body = slurp($resp_file);

    unlink $req_file;
    unlink $resp_file if defined $resp_file;
    unlink $err_file;

    if ($exit_code != 0) {
        die qq[curl failed (exit $exit_code): $stderr];
    }

    $http_code //= '';
    $http_code =~ s/\s+//g;
    if ($http_code !~ /^\d+$/) {
        die qq[curl failed to return HTTP status code];
    }

    return {
        status_code => int($http_code),
        body        => $resp_body,
        stderr      => $stderr,
    };
}

package Synergy::Util;

use strict;
use warnings;
use File::Temp qw(tempfile);

my $uuid_generator;

BEGIN {
    eval { require Data::UUID; 1 } and $uuid_generator = Data::UUID->new();
}

