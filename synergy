sub print_or_page {
    my (%args)     = @_;
    my $text       = $args{text};
    my $agent_mode = $args{agent_mode};

    # Defensive: avoid uninitialized warnings; treat undef as empty.
    $text //= q[];

    # In agent mode (automation/tests), never invoke a pager; just print.
    if ($agent_mode) {
        print $text;
        return;
    }

    # If either side is not a TTY (e.g., piped/non-interactive, test
    # harness), paging would block or be useless. Just print directly.
    unless (-t STDIN && -t STDOUT) {
        print $text;
        return;
    }

    my @pager_argv = ('less');

    # Interactive TTY: write to a temp file and invoke a fixed pager.
    # This avoids readline/pipe interactions that can make the REPL think
    # it saw EOF after the pager exits.
    my $pager_file;
    my $ok = eval {
        my ($pfh, $tmp_path)
          = tempfile('synergy_pager_XXXX', TMPDIR => 1, SUFFIX => '.txt');
        $pager_file = $tmp_path;
        print {$pfh} $text or die "write pager temp file failed: $!";
        close $pfh         or die "close pager temp file failed: $!";

        system {$pager_argv[0]} @pager_argv, $pager_file;
        die "pager exec failed: $!" if $? == -1;
        my $exit_code = $? >> 8;
        die "pager failed with exit $exit_code" if $exit_code != 0;

        unlink $pager_file;
        1;
    };

    if (!$ok) {
        my $error = $@ || 'unknown pager error';
        chomp $error;
        say "WARNING: pager failed ($error); printing directly";
        unlink $pager_file if defined($pager_file) && -f $pager_file;
        print $text;
    }

    return;
}

sub ring_terminal_bell {
    my (%args) = @_;
    return if $args{stdin_is_pipe};
    print "\a";
    return;
}

sub append_to_log {
    my ($logfile, $msg) = @_;

    # Ensure the directory for the logfile exists
    require File::Basename;
    my $log_dir = File::Basename::dirname($logfile);

    if (defined $log_dir && length $log_dir) {
        unless (-d $log_dir) {
            eval { mkdir $log_dir };
        }
    }

    open my $fh, ">>", $logfile
      or die qq[$0: Can'\''t open logfile '\''$logfile'\'': $!\n];
    say $fh $msg;
    close $fh;
}

package Synergy::Patch;

use strict;
use warnings;
use feature     qw/ say /;
use File::Slurp qw/ slurp /;
use File::Spec;
use Cwd;

# Print an error/status message and, in agent mode, append it to the
# conversation so the assistant sees the same feedback the user does.
sub emit_err {
    my ($msg, $convo_aref, $agent_mode) = @_;
    $msg //= '';
    say $msg;
    push @$convo_aref, $msg if $agent_mode && $convo_aref;
    return;
}

# Split text into line records for fuzzy matching.  Terminators
# (\n, \r\n, or \r) are consumed but excluded from each line's content
# and end offset, so replacements never eat the newline after a match.
sub _match_lines_with_offsets {
    my ($text) = @_;
    my @lines;
    my $len   = length $text;
    my $pos   = 0;
    my $start = 0;
    while ($pos < $len) {
        my $c = substr($text, $pos, 1);
        if ($c eq "\n" || $c eq "\r") {
            push @lines,
              {
                content => substr($text, $start, $pos - $start),
                start   => $start,
                end     => $pos,
              };
            $pos++;
            $pos++
              if $c eq "\r" && $pos < $len && substr($text, $pos, 1) eq "\n";
            $start = $pos;
        }
        else {
            $pos++;
        }
    }
    if ($start < $len) {
        push @lines,
          {
            content => substr($text, $start, $len - $start),
            start   => $start,
            end     => $len,
          };
    }
    return \@lines;
}

# Canonicalize one line at a tolerance level: 0 = as-is (line endings
# already normalized by the splitter), 1 = trailing spaces/tabs
# stripped, 2 = space/tab runs collapsed to one space and both ends
# trimmed.
sub _canon_match_line {
    my ($line, $level) = @_;
    return $line if $level == 0;
    if ($level == 1) {
        my $end = length $line;
        $end--
          while $end > 0 && index(" \t", substr($line, $end - 1, 1)) >= 0;
        return substr($line, 0, $end);
    }
    my $canon   = '';
    my $pending = 0;
    for my $i (0 .. length($line) - 1) {
        my $c = substr($line, $i, 1);
        if ($c eq ' ' || $c eq "\t") {
            $pending = 1;
            next;
        }
        $canon .= ' ' if $pending && length $canon;
        $canon .= $c;
        $pending = 0;
    }
    return $canon;
}

sub _canon_lines {
    my ($lines, $level) = @_;
    return [map { _canon_match_line($_->{content}, $level) } @$lines];
}

# Find the file-line window whose canonicalized lines all equal the
# canonicalized search lines.  Returns (count, start, end); the edit is
# refused upstream unless exactly one window matches.
sub _unique_line_span {
    my ($file_lines, $file_canon, $needle) = @_;
    my $n = scalar @$needle;
    return (0, undef, undef) if !$n || $n > @$file_lines;

    my @spans;
  CANDIDATE: for my $i (0 .. @$file_lines - $n) {
        for my $j (0 .. $n - 1) {
            next CANDIDATE if $file_canon->[$i + $j] ne $needle->[$j];
        }
        push @spans,
          [$file_lines->[$i]{start}, $file_lines->[$i + $n - 1]{end}];
        last if @spans > 1;
    }
    return (1, @{$spans[0]}) if @spans == 1;
    return (2, undef, undef) if @spans > 1;
    return (0, undef, undef);
}

# Match only the first and last non-empty search lines, a fixed number
# of lines apart, ignoring the (possibly model-mangled) interior.
sub _unique_anchor_window_span {
    my ($file_lines, $file_canon, $search_canon) = @_;

    my @nonempty_idx
      = grep { $search_canon->[$_] ne '' } 0 .. $#$search_canon;
    return ('skipped:no_nonempty', undef, undef) unless @nonempty_idx;

    my $first_idx = $nonempty_idx[0];
    my $last_idx  = $nonempty_idx[-1];
    my $span_len  = $last_idx - $first_idx + 1;
    return ('skipped:single_line', undef, undef) if $span_len < 2;

    my $first_anchor = $search_canon->[$first_idx];
    my $last_anchor  = $search_canon->[$last_idx];

    my @spans;
    for my $i (0 .. $#$file_lines) {
        my $j = $i + $span_len - 1;
        last if $j > $#$file_lines;
        next
          unless $file_canon->[$i] eq $first_anchor
          && $file_canon->[$j] eq $last_anchor;
        push @spans, [$file_lines->[$i]{start}, $file_lines->[$j]{end}];
        last if @spans > 1;
    }
    return (1, @{$spans[0]}) if @spans == 1;
    return (2, undef, undef) if @spans > 1;
    return (0, undef, undef);
}

# When the exact index() match misses, look for a unique whole-line
# match at increasing whitespace tolerance, then fall back to endpoint
# anchors.  Ambiguous (non-unique) matches are refused at every level.
sub _apply_fallback_match {
    my (%args)       = @_;
    my $result       = $args{result}       // '';
    my $search_text  = $args{search_text}  // '';
    my $replace_text = $args{replace_text} // '';

    return {applied => 0, mode => '', result => $result, attempts => [],}
      unless length $search_text;

    my @attempts     = ('exact=0');
    my $file_lines   = _match_lines_with_offsets($result);
    my $search_lines = _match_lines_with_offsets($search_text);

    my @passes = (['line_endings', 0], ['trailing_ws', 1], ['ws_fuzzy', 2],);
    for my $pass (@passes) {
        my ($mode, $level) = @$pass;
        my ($count, $start, $end) = _unique_line_span(
            $file_lines,
            _canon_lines($file_lines,   $level),
            _canon_lines($search_lines, $level),
        );
        push @attempts, "$mode=" . ($count > 1 ? '2+' : $count);
        if ($count == 1) {
            substr($result, $start, $end - $start, $replace_text);
            return {
                applied  => 1,
                mode     => $mode,
                result   => $result,
                attempts => \@attempts,
            };
        }
    }

    my ($anchor_count, $anchor_start, $anchor_end)
      = _unique_anchor_window_span(
        $file_lines,
        _canon_lines($file_lines,   2),
        _canon_lines($search_lines, 2),
      );
    my $anchor_detail
      = index($anchor_count, 'skipped') == 0 ? $anchor_count
      : $anchor_count > 1                    ? '2+'
      :                                        $anchor_count;
    push @attempts, "anchor_window=$anchor_detail";
    if ($anchor_detail eq '1') {
        substr($result, $anchor_start, $anchor_end - $anchor_start,
            $replace_text);
        return {
            applied  => 1,
            mode     => 'anchor_window',
            result   => $result,
            attempts => \@attempts,
        };
    }

    return {
        applied  => 0,
        mode     => '',
        result   => $result,
        attempts => \@attempts,
    };
}

sub _agent_search_not_found_diagnostics {
    my (%args)      = @_;
    my $search_text = $args{search_text} // '';
    my $attempts    = $args{attempts}    // [];

    my $line_count = 0;
    if (length $search_text) {
        my @lines = split /\r\n|\n|\r/, $search_text, -1;
        $line_count = scalar @lines;
    }

    my @lines            = split /\r\n|\n|\r/, $search_text, -1;
    my ($first_nonempty) = grep         {/\S/} @lines;
    my ($last_nonempty)  = reverse grep {/\S/} @lines;
    $first_nonempty //= $lines[0]  // '';
    $last_nonempty  //= $lines[-1] // '';

    my $first = substr($first_nonempty, 0, 80);
    my $last  = substr($last_nonempty,  0, 80);
    $first =~ s/\s+/ /g;
    $last  =~ s/\s+/ /g;
    $first =~ s/'/\\'/g;
    $last  =~ s/'/\\'/g;

    my $attempt_summary = join(', ', @$attempts);

    return
        "apply_patch diagnostics: chars="
      . length($search_text)
      . " lines=$line_count first_line='$first' last_line='$last' attempted_passes=$attempt_summary";
}

sub _canonical_patch_path {
    my ($filename) = @_;

    my $abs_filename  = File::Spec->rel2abs($filename);
    my $real_filename = Cwd::realpath($abs_filename);
    return $real_filename if defined $real_filename;

    my ($volume, $directories, $file) = File::Spec->splitpath($abs_filename);
    my $parent      = File::Spec->catpath($volume, $directories, '');
    my $real_parent = Cwd::realpath($parent);
    return File::Spec->catfile($real_parent, $file) if defined $real_parent;

    return File::Spec->canonpath($abs_filename);
}

sub _trim_ws {
    my ($text) = @_;
    $text //= '';
    my $start = 0;
    my $end   = length $text;
    $start++
      while $start < $end && index(" \t\r\n", substr($text, $start, 1)) >= 0;
    $end--
      while $end > $start
      && index(" \t\r\n", substr($text, $end - 1, 1)) >= 0;
    return substr($text, $start, $end - $start);
}

sub _expand_nl_tokens {
    my ($text) = @_;
    my $pos = index($text, '<NL>');
    while ($pos >= 0) {
        substr($text, $pos, 4, "\n");
        $pos = index($text, '<NL>', $pos + 1);
    }
    return $text;
}

sub _marker_run_length {
    my ($line, $char) = @_;
    my $n = 0;
    $n++ while $n < length($line) && substr($line, $n, 1) eq $char;
    return $n;
}

# Classify a diff line as a control line: 'open' (<{4,8} ORIGINAL),
# 'sep' (={4,8}), 'close' (>{4,8} UPDATED), or '' for ordinary content.
# Control markers must start at column 0; marker-like text that is
# indented or quoted inside ORIGINAL/UPDATED content stays content.
sub _control_kind {
    my ($line) = @_;
    return '' unless length $line;
    my $first = substr($line, 0, 1);
    if ($first eq '<') {
        my $n = _marker_run_length($line, '<');
        return 'open'
          if $n >= 4 && $n <= 8 && substr($line, $n, 9) eq ' ORIGINAL';
    }
    elsif ($first eq '=') {
        my $n = _marker_run_length($line, '=');
        return 'sep'
          if $n >= 4 && $n <= 8 && _trim_ws(substr($line, $n)) eq '';
    }
    elsif ($first eq '>') {
        my $n = _marker_run_length($line, '>');
        return 'close'
          if $n >= 4 && $n <= 8 && substr($line, $n, 8) eq ' UPDATED';
    }
    return '';
}

sub _split_diff_lines {
    my ($text) = @_;
    my @lines;
    my $pos = 0;
    while ((my $nl = index($text, "\n", $pos)) >= 0) {
        push @lines, substr($text, $pos, $nl - $pos);
        $pos = $nl + 1;
    }
    push @lines, substr($text, $pos) if $pos < length $text;
    for my $line (@lines) {
        chop $line if length $line && substr($line, -1) eq "\r";
    }
    return @lines;
}

sub _is_marker_word {
    my ($word, $char) = @_;
    my $n = length $word;
    return $n >= 4 && $n <= 8 && $word eq ($char x $n);
}

# A diff that arrives with its newlines collapsed to spaces has its
# control markers mid-line.  Rebuild a canonical multi-line diff by
# treating marker words as line breaks.  Content whitespace fidelity is
# already lost in this shape; search/replace text is trimmed anyway.
# Known limitation: a bare ={4,8} word inside content misparses here;
# use <NL> encoding for such patches.
sub _normalize_one_line_diff {
    my ($text) = @_;
    my @words  = split ' ', $text;
    my (@lines, @content);
    my $flush = sub {
        push @lines, join(' ', @content) if @content;
        @content = ();
    };
    my $i = 0;
    while ($i < @words) {
        my $word = $words[$i];
        my $next = $i + 1 < @words ? $words[$i + 1] : '';
        if (_is_marker_word($word, '<') && $next eq 'ORIGINAL') {
            $flush->();
            push @lines, "$word ORIGINAL";
            $i += 2;
        }
        elsif (_is_marker_word($word, '=')) {
            $flush->();
            push @lines, $word;
            $i++;
        }
        elsif (_is_marker_word($word, '>') && $next eq 'UPDATED') {
            $flush->();
            push @lines, "$word UPDATED";
            $i += 2;
        }
        else {
            push @content, $word;
            $i++;
        }
    }
    $flush->();
    return join("\n", @lines);
}

# Line-based state machine: seek an opener, collect ORIGINAL lines to
# the separator, collect UPDATED lines to the closer, emit a block.
# Text outside blocks is ignored; a block left open at end-of-input is
# discarded so malformed patches yield no blocks rather than bad edits.
sub _parse_edit_blocks {
    my ($diff_text) = @_;
    $diff_text = _normalize_one_line_diff($diff_text)
      if index($diff_text, "\n") < 0;

    my @blocks;
    my $state = 'seek';
    my (@original, @updated);
    for my $line (_split_diff_lines($diff_text)) {
        my $kind = _control_kind($line);
        if ($state eq 'seek') {
            if ($kind eq 'open') {
                $state    = 'original';
                @original = ();

                # REPL multi-line accumulation chomps the command line
                # before appending continuation lines, which glues the
                # first content line onto the opener: <<<<<< ORIGINALfoo.
                # Text after the marker is the first ORIGINAL line.
                my $run  = _marker_run_length($line, '<');
                my $rest = substr($line, $run + 9);
                push @original, $rest if length $rest;
            }
        }
        elsif ($state eq 'original') {
            if ($kind eq 'sep') {
                $state   = 'updated';
                @updated = ();
            }
            else {
                push @original, $line;
            }
        }
        elsif ($state eq 'updated') {
            if ($kind eq 'close') {
                push @blocks,
                  {
                    search  => join("\n", @original),
                    replace => join("\n", @updated),
                  };
                $state = 'seek';
            }
            else {
                push @updated, $line;
            }
        }
    }
    return @blocks;
}

sub apply_patch {
    my (%args)     = @_;
    my $convo      = $args{convo_aref};
    my $agent_mode = $args{agent_mode};
    my $raw_args   = _trim_ws($args{raw_args});

    if (!length $raw_args) {
        emit_err("ERROR: No filename provided to ,apply_patch",
            $convo, $agent_mode);
        return;
    }

    my $name_end = 0;
    $name_end++
      while $name_end < length($raw_args)
      && index(" \t\r\n", substr($raw_args, $name_end, 1)) < 0;
    my $filename  = substr($raw_args, 0, $name_end);
    my $diff_text = _trim_ws(substr($raw_args, $name_end));

    if (!length $diff_text) {
        emit_err("ERROR: No diff text provided to ,apply_patch",
            $convo, $agent_mode);
        return;
    }

    # The diff may be wrapped in single quotes.  Strip each side
    # independently: trailing REPL input swallowed into the argument
    # (e.g. a following command line) can sit after the closing quote,
    # and the block parser ignores any such text outside edit blocks.
    $diff_text = substr($diff_text, 1)
      if length($diff_text) && substr($diff_text, 0, 1) eq "'";
    $diff_text = substr($diff_text, 0, length($diff_text) - 1)
      if length($diff_text) && substr($diff_text, -1) eq "'";
    $diff_text = _expand_nl_tokens($diff_text);

    my $abs_path
      = File::Spec->file_name_is_absolute($filename)
      ? $filename
      : File::Spec->catfile($args{cwd} // Cwd::getcwd(), $filename);
    my $canonical = _canonical_patch_path($abs_path);
    my $home      = $ENV{HOME} // '';
    $home = Cwd::realpath($home) // $home if length $home;
    unless (length $home
        && ($canonical eq $home || index($canonical, "$home/") == 0))
    {
        emit_err("ERROR: File '$filename' must be within \$HOME\nHOME: $home",
            $convo, $agent_mode);
        return;
    }
    if (-d $canonical) {
        emit_err("ERROR: '$filename' is a directory, not a file",
            $convo, $agent_mode);
        return;
    }
    my $file_exists = -e $canonical ? 1 : 0;
    emit_err("File '$filename' does not exist, will create new file",
        $convo, $agent_mode)
      unless $file_exists;

    my @blocks = _parse_edit_blocks($diff_text);
    if (!@blocks) {
        emit_err("ERROR: No valid edit blocks found in diff text",
            $convo, $agent_mode);
        return;
    }

    # Read as UTF-8 characters so index/substr matching agrees with
    # the model's patch text (already characters, decoded from the
    # response JSON) and with the :utf8 write side below. A file that
    # is not valid UTF-8 (binary) stays bytes and is written back
    # through :raw — never re-encoded either way. Reading bytes here
    # while writing through the utf8::all-layered handle was the bug
    # that double-encoded every non-ASCII character in a patched file.
    my ($content, $content_is_bytes) = ('', 0);
    if ($file_exists) {
        my $raw     = slurp($canonical);
        my $decoded = Synergy::Util::decode_utf8_or_undef($raw);
        if   (defined $decoded) { $content = $decoded }
        else                    { $content = $raw; $content_is_bytes = 1 }
    }
    my $applied = 0;
    for my $block (@blocks) {
        my $search  = _trim_ws($block->{search});
        my $replace = _trim_ws($block->{replace});

        # Empty ORIGINAL means append (and covers new-file creation).
        if (!length $search) {
            $content .= $replace;
            $applied++;
            next;
        }
        my $pos = index($content, $search);
        if ($pos >= 0) {
            substr($content, $pos, length($search), $replace);
            $applied++;
            next;
        }
        my $fallback = _apply_fallback_match(
            result       => $content,
            search_text  => $search,
            replace_text => $replace,
        );
        if ($fallback->{applied}) {
            $content = $fallback->{result};
            $applied++;
            next;
        }
        emit_err("WARNING: Search text not found: '$search'",
            $convo, $agent_mode);
        emit_err(
            _agent_search_not_found_diagnostics(
                search_text => $search,
                attempts    => $fallback->{attempts},
            ),
            $convo,
            $agent_mode
        );
    }

    if (!$applied) {
        emit_err("WARNING: No changes were applied to file '$filename'",
            $convo, $agent_mode);
        return;
    }

    my $out_mode = $content_is_bytes ? '>:raw' : '>:utf8';
    if (open my $out, $out_mode, $canonical) {
        print {$out} $content;
        close $out;
    }
    else {
        emit_err("ERROR: Could not write to file '$filename': $!",
            $convo, $agent_mode);
        return;
    }

    emit_err("apply_patch: Applied edits to file '$filename'",
        $convo, $agent_mode);
    return;
}

package Synergy::Exec;

use strict;
use warnings;
use feature        qw/ say /;
use File::Basename qw(basename);
use File::Slurp    qw/ slurp /;
use Time::HiRes    qw/ time /;
use Try::Tiny;
use Text::ParseWords qw(shellwords);

sub allowed_commands {
    return qw(rg grep sed wc ls file find cat make head nl prove git time);
}

sub _parse_exec_error {
    my ($msg) = @_;
    return {error => $msg};
}

# Split a raw ,exec line into pipeline segments on unquoted '|'.
# Other shell operators are rejected outright: a single command execs
# with no shell, and a pipeline only ever gets the '|' we place
# between policy-checked segments, so an unquoted ';', '&', '<', or
# '>' would silently become a literal argument — an error is kinder
# than a command that quietly does something else. Quoted operators
# pass through as ordinary argument text.
sub _split_pipeline {
    my ($cmd) = @_;

    my @segments = ('');
    my $len      = length $cmd;
    my ($in_single, $in_double) = (0, 0);

    my $i = 0;
    while ($i < $len) {
        my $c = substr($cmd, $i, 1);

        if ($in_single) {
            $in_single = 0 if $c eq q['];
            $segments[-1] .= $c;
            $i++;
            next;
        }
        if ($in_double || $c eq '\\') {
            if ($c eq '\\' && $i + 1 < $len) {
                $segments[-1] .= substr($cmd, $i, 2);
                $i += 2;
                next;
            }
            $in_double = 0 if $in_double && $c eq q["];
            $segments[-1] .= $c;
            $i++;
            next;
        }
        if ($c eq q[']) { $in_single = 1; }
        if ($c eq q["]) { $in_double = 1; }

        if ($c eq '|') {
            if (substr($cmd, $i + 1, 1) eq '|') {
                return (undef,
                    qq[ERROR: shell operator '||' is not supported in ,exec (only '|' pipelines)]
                );
            }
            push @segments, '';
            $i++;
            next;
        }
        if ($c eq ';' || $c eq '&' || $c eq '<' || $c eq '>') {
            return (undef,
                qq[ERROR: shell operator '$c' is not supported in ,exec (only '|' pipelines)]
            );
        }

        $segments[-1] .= $c;
        $i++;
    }

    if (@segments > 1) {
        for my $segment (@segments) {
            return (undef, "ERROR: empty pipeline segment in ,exec command")
              if $segment !~ /\S/;
        }
    }

    return (\@segments, undef);
}

sub parse_exec_command {
    my (%args) = @_;
    my $cmd = $args{cmd};

    unless ($cmd) {
        return _parse_exec_error("ERROR: No command provided to ,exec");
    }

    my ($segment_strings, $split_error) = _split_pipeline($cmd);
    return _parse_exec_error($split_error) if defined $split_error;

    my @segments;
    for my $segment_string (@$segment_strings) {
        my @argv;
        try {
            @argv = shellwords($segment_string);
        }
        catch {
            return _parse_exec_error(
                "ERROR: Failed to parse ,exec command: $_");
        };

        unless (@argv) {
            return _parse_exec_error("ERROR: No command provided to ,exec");
        }

        for my $a (@argv) {
            if (!defined $a || $a =~ /\0/ || $a =~ /[\r\n]/) {
                return _parse_exec_error(
                    "ERROR: Invalid control characters in ,exec arguments");
            }
        }

        push @segments,
          {
            argv            => \@argv,
            raw_base_cmd    => $argv[0],
            policy_base_cmd => basename($argv[0]),
            full_cmd        => join(' ', @argv),
          };
    }

    my $first = $segments[0];
    return {
        segments        => \@segments,
        argv            => $first->{argv},
        raw_base_cmd    => $first->{raw_base_cmd},
        policy_base_cmd => $first->{policy_base_cmd},
        full_cmd        => join(' | ', map { $_->{full_cmd} } @segments),
    };
}

sub _git_subcommand_blocked_reason {
    my ($argv_aref) = @_;
    my ($subcmd, @tokens) = _git_subcommand_tokens($argv_aref);
    return undef unless defined $subcmd;

    my %always_blocked = map { $_ => 1 } qw(rebase);
    return "git $subcmd is not permitted" if $always_blocked{$subcmd};

    if ($subcmd eq 'push') {
        return _git_push_blocked_reason(@tokens);
    }

    my %flagged = (reset => [qw(--hard)], commit => [qw(--amend)],);
    if (my $blocked_flags = $flagged{$subcmd}) {
        for my $flag (@$blocked_flags) {
            if (grep { $_ eq $flag } @tokens) {
                return "git $subcmd $flag is not permitted";
            }
        }
    }

    # git branch -D (force-delete); -d (merged-only) is fine
    if ($subcmd eq 'branch' && grep { $_ eq '-D' } @tokens) {
        return "git branch -D is not permitted";
    }

    # git clean -f / -fd / -fx etc.
    if ($subcmd eq 'clean' && grep {/^-[a-z]*f/i} @tokens) {
        return "git clean -f is not permitted";
    }

    return undef;
}

sub _git_subcommand_tokens {
    my ($argv_aref) = @_;
    my @tokens = @{$argv_aref // []};
    shift @tokens;    # remove 'git'

    while (@tokens) {
        my $t = shift @tokens;

        if ($t eq '-C' || $t eq '-c') {
            shift @tokens if @tokens;
            next;
        }

        if ($t
            =~ /^--(?:git-dir|work-tree|namespace|super-prefix|exec-path|config-env)$/
          )
        {
            shift @tokens if @tokens;
            next;
        }

        next
          if $t
          =~ /^--(?:git-dir|work-tree|namespace|super-prefix|exec-path|config-env)=/;

        next if $t =~ /^-/;

        return ($t, @tokens);
    }

    return;
}

sub _git_push_blocked_reason {
    my (@tokens) = @_;

    for my $t (@tokens) {
        return "git push --force is not permitted"
          if $t eq '--force' || $t eq '-f' || $t =~ /^-[^-]*f/;
        return "git push --force-with-lease is not permitted"
          if $t eq '--force-with-lease' || $t =~ /^--force-with-lease=/;
        return "git push --delete is not permitted"
          if $t eq '--delete' || $t eq '-d' || $t =~ /^-[^-]*d/;
        return "git push --mirror is not permitted"       if $t eq '--mirror';
        return "git push --prune is not permitted"        if $t eq '--prune';
        return "git push force refspec is not permitted"  if $t =~ /^\+/;
        return "git push delete refspec is not permitted" if $t =~ /^:/;
    }

    return undef;
}

# The blade guards: one command policy for every worker, human or
# agent. 'deny' is enforced unconditionally; 'confirm' means the
# agent must ask (a human typing the command is their own approval);
# 'allow' runs without ceremony.
sub exec_policy {
    my (%args)   = @_;
    my $base_cmd = $args{base_cmd} // '';
    my $argv     = $args{argv}     // [];
    $base_cmd = basename($base_cmd);

    my @always_allowed_commands   = grep { $_ ne 'git' } allowed_commands();
    my @confirm_required_commands = qw(git perl);
    my @never_allowed_commands
      = qw(rm sh bash zsh env python python3 ruby node);

    return 'deny' if grep { $_ eq $base_cmd } @never_allowed_commands;

    if ($base_cmd eq 'git') {
        my $reason = _git_subcommand_blocked_reason($argv);
        return ('deny', $reason) if defined $reason;
        return 'confirm';
    }

    return 'confirm' if grep { $_ eq $base_cmd } @confirm_required_commands;
    return 'allow'   if grep { $_ eq $base_cmd } @always_allowed_commands;
    return 'confirm';
}

# Policy for a whole pipeline: the most restrictive segment wins.
# Returns ('deny', $reason_or_undef, $denied_raw_base_cmd),
# ('confirm'), or ('allow').
sub pipeline_policy {
    my (%args) = @_;
    my $segments = $args{segments} // [];

    my $needs_confirm = 0;
    for my $segment (@$segments) {
        my ($policy, $reason) = exec_policy(
            base_cmd => $segment->{policy_base_cmd},
            argv     => $segment->{argv},
        );
        if ($policy eq 'deny') {
            return ('deny', $reason, $segment->{raw_base_cmd});
        }
        $needs_confirm = 1 if $policy eq 'confirm';
    }

    return ($needs_confirm ? 'confirm' : 'allow');
}

sub _shell_status_note {
    my ($output_ref, $exit_code) = @_;
    return unless defined $output_ref;

    if ($exit_code == -1) {
        $$output_ref .= "\nWARNING: Command exited with status -1";
        return;
    }
    if ($exit_code & 127) {
        $$output_ref .= "\nWARNING: Command exited with status $exit_code";
        return;
    }

    my $real_exit = $exit_code >> 8;
    $$output_ref .= "\nWARNING: Command exited with status $real_exit"
      if $real_exit != 0;
    return;
}

sub _slurp_command_output {
    my ($temp_file) = @_;
    return ('', '') unless -f $temp_file;

    my $t       = slurp($temp_file);
    my $decoded = Synergy::Util::decode_utf8_or_undef($t);
    if (defined $decoded) {
        $t = $decoded;
    }
    else {
        # not valid UTF-8 (binary output): scrub to ASCII placeholders
        $t =~ s/[^[:ascii:]]/?/g;
    }

    my $command_output = $t;
    $command_output =~ s/\ACOMMAND:\n.*?\nOUTPUT:\n//s;

    return ($t, $command_output);
}

# Cap the command output that is stored in conversation history (and
# echoed to the REPL). Oversized output becomes a head and tail around
# an elision marker; the full output stays in the temp file, which an
# agent can re-read in slices when it needs the middle. Uncapped tool
# output is the main driver of context growth in agent sessions.
sub _capped_command_output {
    my ($command_output, $temp_file) = @_;

    my $cap = $ENV{SYNERGY_EXEC_OUTPUT_CAP};
    $cap = 20_000 unless defined($cap) && $cap =~ /^\d+$/;
    return $command_output if !$cap || length($command_output) <= $cap;

    my $half   = int($cap / 2);
    my $elided = length($command_output) - 2 * $half;
    return
        substr($command_output, 0, $half)
      . "\n[... $elided bytes elided; full output in '$temp_file' ...]\n"
      . substr($command_output, -$half);
}

sub _agent_exec_summary {
    my (%args)         = @_;
    my $prefix         = $args{prefix}         // 'exec';
    my $full_cmd       = $args{full_cmd}       // '';
    my $output         = $args{output}         // '';
    my $command_output = $args{command_output} // '';
    my $temp_file      = $args{temp_file};
    my $byte_count     = length $command_output;
    my $line_count     = ($command_output =~ tr/\n/\n/);
    $line_count++ if length($command_output) && $command_output !~ /\n\z/;

    if ($output =~ /\nWARNING: Command exited with status (\d+)/) {
        my $status  = $1;
        my $summary = qq[$prefix: $full_cmd exited $status];
        if ($byte_count) {
            $summary .= qq[ ($line_count lines, $byte_count bytes)];
        }
        else {
            $summary .= qq[ (no output)];
        }
        $summary .= qq[; output saved to '$temp_file'] if -f $temp_file;
        say $summary;
        return;
    }

    if ($output =~ /\nERROR:/ || $output =~ /\nWARNING:/) {
        say $output;
        return;
    }

    if ($byte_count) {
        say qq[$prefix: $full_cmd ($line_count lines, $byte_count bytes)];
    }
    else {
        say qq[$prefix: $full_cmd (no output)];
    }
    return;
}

# Runner for ,exec: capture the command's combined stdout/stderr in
# a temp file, annotate exit status, and route the result to the
# conversation, the log, and the REPL/agent output. `isolate` closes
# stdin and neutralizes pager/editor environment variables in the
# child.
sub _run_captured {
    my (%args)     = @_;
    my $label      = $args{label};
    my $display    = $args{display_cmd};
    my $argv       = $args{argv};
    my $isolate    = $args{isolate};
    my $convo_aref = $args{convo_aref} // [];
    my $agent_mode = $args{agent_mode};
    my $logfile    = $args{logfile};

    my $temp_file
      = "/tmp/synergy_${label}_pid_$$" . "_timestamp_" . time() . ".txt";

    my $output = "$label: $display";
    say $output unless $agent_mode;

    if (open my $tfh, '>', $temp_file) {
        print $tfh "COMMAND:\n$display\nOUTPUT:\n";
        close $tfh;

        my $pid = fork();
        if (!defined $pid) {
            say "ERROR: Failed to fork for ,$label: $!";
            $output .= "\nWARNING: Command exited with status -1";
        }
        elsif ($pid == 0) {
            if ($isolate) {
                open my $in, '<',  '/dev/null' or die "open /dev/null: $!";
                open STDIN,  '<&', $in         or die "dup stdin: $!";
                $ENV{'PAGER'}               = 'cat';
                $ENV{'GIT_PAGER'}           = 'cat';
                $ENV{'GIT_TERMINAL_PROMPT'} = '0';
                $ENV{'GIT_EDITOR'}          = 'true';
                $ENV{'EDITOR'}              = 'true';
                $ENV{'VISUAL'}              = 'true';
            }
            open my $out, '>>', $temp_file or die "open temp_file: $!";
            open STDOUT,  '>&', $out       or die "dup stdout: $!";
            open STDERR,  '>&', $out       or die "dup stderr: $!";
            exec {$argv->[0]} @$argv or die "exec failed: $!";
        }
        else {
            waitpid($pid, 0);
            _shell_status_note(\$output, $?);

            if (!-e $temp_file) {
                $output .= "\nERROR: Output file was not created";
            }
            elsif (!-s $temp_file) {
                $output
                  .= "\nINFO: Command executed successfully but produced no output"
                  unless $output =~ /\nWARNING:/;
            }
        }
    }
    else {
        say "ERROR: Failed to write $label output file: $!";
        $output .= "\nERROR: Output file was not created";
    }

    my ($t, $command_output) = _slurp_command_output($temp_file);
    if (-f $temp_file) {
        say "$label: output saved to '$temp_file'" unless $agent_mode;
        my $stored = _capped_command_output($command_output, $temp_file);
        $t = "COMMAND:\n$display\nOUTPUT:\n$stored"
          if $stored ne $command_output;
        $output .= qq[\n$t];
    }

    push @$convo_aref, $output;
    Synergy::Util::append_to_log($logfile, $output)
      if defined $logfile && length $logfile;

    if ($agent_mode) {
        _agent_exec_summary(
            prefix         => $label,
            full_cmd       => $display,
            output         => $output,
            command_output => $command_output,
            temp_file      => $temp_file,
        );
    }
    else {
        print qq[$output];
    }
    return;
}

sub _shell_quote {
    my ($word) = @_;
    $word //= '';
    $word =~ s/'/'\\''/g;
    return qq['$word'];
}

# A single command execs directly with no shell. A pipeline runs via
# /bin/sh -c, which is safe here because every word is single-quote
# escaped and the only shell operator in the string is the '|' we
# place between policy-checked segments.
sub _pipeline_argv {
    my ($segments) = @_;
    return $segments->[0]{argv} if @$segments == 1;

    my $pipeline = join ' | ', map {
        join ' ',
          map { _shell_quote($_) }
          @{$_->{argv}}
    } @$segments;
    return ['/bin/sh', '-c', $pipeline];
}

sub run_exec {
    my (%args)      = @_;
    my $cmd         = $args{cmd};
    my $convo_aref  = $args{convo_aref} // [];
    my $agent_mode  = $args{agent_mode};
    my $skip_policy = $args{skip_policy};

    my $parsed = parse_exec_command(cmd => $cmd) or return;
    if ($parsed->{error}) {
        say $parsed->{error};
        push @$convo_aref, $parsed->{error} if $agent_mode;
        return;
    }

    unless ($skip_policy) {
        my ($policy, $deny_reason, $denied_cmd)
          = pipeline_policy(segments => $parsed->{segments});
        if ($policy eq 'deny') {
            say 'ERROR: '
              . ($deny_reason
                  // "Command '$denied_cmd' is not permitted in ,exec");
            return;
        }

        # 'confirm' needs no prompt here: on the human path, typing
        # the command is the approval. The agent path prompts before
        # running the handler and passes skip_policy.
    }

    return _run_captured(
        label       => 'exec',
        display_cmd => $parsed->{full_cmd},
        argv        => _pipeline_argv($parsed->{segments}),
        isolate     => 1,
        convo_aref  => $convo_aref,
        agent_mode  => $agent_mode,
        logfile     => $args{logfile},
    );
}

package Synergy::SessionStore;

use strict;
use warnings;
use feature      qw/ say /;
use File::Slurp  qw/ slurp /;
use MIME::Base64 qw(encode_base64 decode_base64);
use Encode       qw(encode);

# Dumps are written as base64 over UTF-8 bytes (see dump_session);
# decode back to characters on load, falling back to raw bytes for
# legacy dumps whose payload is not valid UTF-8.
sub _dump_elem_text {
    my ($encoded) = @_;
    my $bytes     = decode_base64($encoded);
    my $decoded   = Synergy::Util::decode_utf8_or_undef($bytes);
    return defined $decoded ? $decoded : $bytes;
}
use Mojo::DOM;
use Try::Tiny;
use Time::HiRes qw/ time /;

sub dump_session {
    my (%args) = @_;

    my $filename         = $args{filename};
    my $dump_dir         = $args{dump_dir};
    my $session_id       = $args{session_id};
    my $model            = $args{model};
    my $system_prompt    = $args{system_prompt};
    my $convo_aref       = $args{convo}       // [];
    my $context_aref     = $args{context}     // [];
    my $token_usage_href = $args{token_usage} // {};
    my $auto_dump_mode   = $args{auto_dump_mode};
    my $active_dump_file = $args{active_dump_file};

    my $now = time;
    unless ($filename) {
        $filename = qq[dump-$session_id-$now.xml];
        my $maybe_dump_dir = $dump_dir;
        if (-e -d $maybe_dump_dir) {
            $filename = qq[$maybe_dump_dir/$filename];
        }
        say "WARNING: No filename provided, using '$filename'";
    }

    my $timestamp = time;
    my $model_attr
      = defined $model && length $model ? qq[ model="$model"] : '';
    my $xml = qq[<dump time="$timestamp" session="$session_id"$model_attr>\n];

    my $encoded_prompt = encode_base64(encode("UTF-8", $system_prompt));
    $xml
      .= qq[  <prompt encoding="base64"><![CDATA[$encoded_prompt]]></prompt>\n];

    $xml .= qq[  <convo>\n];
    for my $line (@$convo_aref) {
        my $encoded_line = encode_base64(encode("UTF-8", $line));
        $xml
          .= qq[    <elem encoding="base64"><![CDATA[$encoded_line]]></elem>\n];
    }
    $xml .= qq[  </convo>\n];
    $xml .= qq[  <context>\n];
    for my $file (@$context_aref) {
        my $encoded = encode_base64(encode("UTF-8", $file));
        $xml .= qq[    <elem encoding="base64"><![CDATA[$encoded]]></elem>\n];
    }
    $xml .= qq[  </context>\n];
    if (ref($token_usage_href) eq 'HASH') {
        my $input_tokens  = $token_usage_href->{input_tokens}  // 0;
        my $output_tokens = $token_usage_href->{output_tokens} // 0;
        my $total_tokens
          = defined $token_usage_href->{total_tokens}
          ? $token_usage_href->{total_tokens}
          : ($input_tokens + $output_tokens);
        my $cached_tokens = $token_usage_href->{cached_tokens} // 0;
        $xml
          .= qq[  <tokens input="$input_tokens" output="$output_tokens" total="$total_tokens" cached="$cached_tokens" />\n];
    }

    $xml .= qq[</dump>\n];

    try {
        open my $fh, '>', $filename
          or die "ERROR: Could not open '$filename' for writing: $!";
        print $fh $xml;
        close $fh;
        say "Dumped conversation to '$filename'.";
        if ($auto_dump_mode) {
            ## We continue to set the active dump file to the
            ## current save file, just in case the checks below fail
            ## for some reason. However, we expect that this will be
            ## immediately overwritten below.
            $active_dump_file = $filename;

            my $next_ts        = time;
            my $next_name      = qq[dump-$session_id-$next_ts.xml];
            my $maybe_dump_dir = $dump_dir;
            $active_dump_file
              = (-e -d $maybe_dump_dir)
              ? qq[$maybe_dump_dir/$next_name]
              : $next_name;
        }
    }
    catch {
        say "ERROR: Could not write to '$filename': $_";
    };

    return ($filename, $active_dump_file);
}

sub load_session {
    my (%args) = @_;

    my $filename         = $args{filename};
    my $auto_dump_mode   = $args{auto_dump_mode};
    my $active_dump_file = $args{active_dump_file};

    my $session_id       = $args{session_id};
    my $system_prompt    = $args{system_prompt};
    my $convo_aref       = $args{convo}   // [];
    my $context_aref     = $args{context} // [];
    my $token_usage_href = $args{token_usage};

    unless (-e $filename) {
        if (ref($token_usage_href) eq 'HASH') {
            %$token_usage_href = (
                input_tokens  => 0,
                output_tokens => 0,
                total_tokens  => 0,
                cached_tokens => 0,
            );
        }
        say "ERROR: Please provide a valid filename for the load: $!";
        return ($session_id, $system_prompt, $convo_aref, $context_aref,
            $active_dump_file, undef);
    }

    my $xml_content;
    try {
        say qq[Loading dump file '$filename'];
        $xml_content = slurp($filename);
    }
    catch {
        say "ERROR: Could not read '$filename': $_";
        return ($session_id, $system_prompt, $convo_aref, $context_aref,
            $active_dump_file, undef);
    };

    my $dom = Mojo::DOM->new($xml_content);

    my $session_attr = $dom->at('dump')->attr('session');
    if ($session_attr) {
        $session_id = $session_attr;
        printf "%-35s%s\n", "Loading session ID", "... ok";
    }
    else {
        say
          "WARNING: No session ID found in '$filename', keeping current session ID.";
    }

    # Model the dump was made with (absent in older dumps); the caller
    # switches to it so a reloaded session keeps its warm prompt cache.
    my $dump_model = $dom->at('dump')->attr('model');
    printf "%-35s%s\n", "Loading model", "... ok" if defined $dump_model;

    # Load system prompt with base64 decoding
    my $prompt_node = $dom->find('prompt')->first;
    if ($prompt_node) {
        my $encoded_prompt = $prompt_node->text;
        if (   $prompt_node->attr('encoding')
            && $prompt_node->attr('encoding') eq 'base64')
        {
            $system_prompt = _dump_elem_text($encoded_prompt);
        }
        else {
            # Handle legacy files without encoding
            $system_prompt = $encoded_prompt;
        }
        printf "%-35s%s\n", "Loading system prompt", "... ok";
    }
    else {
        say "WARNING: No system prompt found in '$filename'.";
    }

    # Load conversation with base64 decoding
    my $convo_node = $dom->find('convo')->first;
    if ($convo_node) {
        @$convo_aref = ();
        for my $elem ($convo_node->find('elem')->each) {
            my $text = $elem->text;
            if (   $elem->attr('encoding')
                && $elem->attr('encoding') eq 'base64')
            {
                push @$convo_aref, _dump_elem_text($text);
            }
            else {
                # Handle legacy files without encoding
                push @$convo_aref, $text;
            }
        }
        printf "%-35s%s\n", "Loading conversation", "... ok";
    }
    else {
        say "WARNING: No conversation found in '$filename'.";
    }

    # Load context with base64 decoding
    my $context_node = $dom->find('context')->first;
    if ($context_node) {
        @$context_aref = ();
        for my $elem ($context_node->find('elem')->each) {
            my $text = $elem->text;

            # Check if this element is base64 encoded
            if (   $elem->attr('encoding')
                && $elem->attr('encoding') eq 'base64')
            {
                push @$context_aref, _dump_elem_text($text);
            }
            else {
                # Handle legacy files without encoding
                push @$context_aref, $text;
            }
        }
        printf "%-35s%s\n", "Loading file context stack", "... ok";
    }
    else {
        say "WARNING: No context found in '$filename'.";
    }

    if (ref($token_usage_href) eq 'HASH') {
        my $tokens_node = $dom->find('tokens')->first;
        if ($tokens_node) {
            %$token_usage_href = (
                input_tokens  => ($tokens_node->attr('input')  // 0),
                output_tokens => ($tokens_node->attr('output') // 0),
                total_tokens  => ($tokens_node->attr('total')  // 0),
                cached_tokens => ($tokens_node->attr('cached') // 0),
            );
            printf "%-35s%s\n", "Loading token totals", "... ok";
        }
        else {
            %$token_usage_href = (
                input_tokens  => 0,
                output_tokens => 0,
                total_tokens  => 0,
                cached_tokens => 0,
            );
        }
    }

    if ($auto_dump_mode) {
        $active_dump_file = $filename;
    }

    return ($session_id, $system_prompt, $convo_aref, $context_aref,
        $active_dump_file, $dump_model);
}

package Synergy::ContextStack;

use strict;
use warnings;
use feature     qw/ say /;
use File::Slurp qw/ slurp /;

# How a file's bytes become context text: decoded UTF-8 characters,
# or ASCII-scrubbed bytes for binary content. Shared by push_path
# and the staleness check so comparisons see the same transform.
sub _file_context_text {
    my ($path)  = @_;
    my $t       = slurp($path);
    my $decoded = Synergy::Util::decode_utf8_or_undef($t);
    return $decoded if defined $decoded;
    $t =~ s/[^[:ascii:]]/?/g;
    return $t;
}

# Announce (once per on-disk version) any pushed file whose context
# snapshot no longer matches the file, so either worker can refresh
# it explicitly with ,drop N + ,push. Detection only, by design:
# the stack is jointly owned, so it is never rewritten -- and the
# cache prefix never invalidated -- behind the workers' backs.
my %stale_announced;

sub announce_stale_context {
    my (%args)       = @_;
    my $context_aref = $args{context_aref} // [];
    my $convo_aref   = $args{convo_aref}   // [];

    for my $i (0 .. $#$context_aref) {
        my ($path, $stored)
          = $context_aref->[$i] =~ /\Afile: '(.+)'\ncontents: (.*)\z/s
          or next;

        my ($key, $msg);
        if (!-f $path) {
            $key = qq[$i:$path:gone];
            $msg
              = qq[NOTE: context entry [$i] for '$path' is stale (file no longer exists); ,drop $i to remove it];
        }
        else {
            my $mtime = (stat $path)[9] // 0;
            $key = qq[$i:$path:$mtime];
            next if $stale_announced{$key};
            my $current = eval { _file_context_text($path) };
            next unless defined $current;
            next if $current eq $stored;
            $msg
              = qq[NOTE: context entry [$i] for '$path' is stale (file changed on disk); ,drop $i then ,push $path to refresh];
        }
        next if $stale_announced{$key};
        $stale_announced{$key} = 1;
        say $msg;
        push @$convo_aref, $msg;
    }
    return;
}

# Announce files whose `git status --short` line changed since the
# previous turn, so both workers see edits made outside the REPL
# (editor saves, regenerated artifacts, branch switches). Pushed
# files are covered separately by the staleness check above. A cwd
# change just resets the snapshot rather than announcing a flood.
my ($delta_cwd, $delta_status);

sub announce_git_delta {
    my (%args)     = @_;
    my $convo_aref = $args{convo_aref} // [];
    my $cwd        = Cwd::getcwd();
    my $current    = qx{git status --short 2>/dev/null} // '';
    if (   defined $delta_status
        && $delta_cwd eq $cwd
        && $current ne $delta_status)
    {
        my %prev = map { $_ => 1 } split /\n/, $delta_status;
        my %curr = map { $_ => 1 } split /\n/, $current;
        my %changed;
        for my $line (keys %curr, keys %prev) {
            next if $prev{$line} && $curr{$line};
            my ($path) = $line =~ /^.{2} (.*)\z/ or next;
            $changed{$path} = 1;
        }
        if (my @files = sort keys %changed) {
            my $msg
              = 'NOTE: changed since your last turn: ' . join(', ', @files);
            say $msg;
            push @$convo_aref, $msg;
        }
    }
    ($delta_cwd, $delta_status) = ($cwd, $current);
    return;
}

sub push_path {
    my (%args)             = @_;
    my $file_or_directory  = $args{file_or_directory};
    my $context_aref       = $args{context_aref};
    my $convo_aref         = $args{convo_aref};
    my $already_in_context = $args{already_in_context_href};
    my $agent_mode         = $args{agent_mode};

    my $output;
    chomp $file_or_directory;
    if ($already_in_context->{$file_or_directory} && $agent_mode) {
        $output
          = qq[ERROR: $file_or_directory is already in context, ignoring ...];
        goto PUSH_END;
    }
    $already_in_context->{$file_or_directory}++;
    if (-d $file_or_directory) {
        my @listing;
        my $dh;
        opendir $dh, $file_or_directory;
        @listing = readdir $dh;
        @listing = grep { $_ !~ /(\.$|\.\.$)/ } @listing;
        closedir $dh;
        $output = qq[ directory: '$file_or_directory'\n contents: @listing];
    }
    elsif (-f $file_or_directory
        && Synergy::Util::image_mime_type($file_or_directory))
    {
        # Store a placeholder; the provider builders read and
        # base64-encode the file at request time. Guard against
        # payloads the providers would reject (Anthropic's limit is
        # 5 MB decoded per image; base64 inflates by 4/3).
        my $max_bytes = 4_000_000;
        if (defined $ENV{SYNERGY_MAX_IMAGE_BYTES}
            && $ENV{SYNERGY_MAX_IMAGE_BYTES} =~ /^\d+$/)
        {
            $max_bytes = int($ENV{SYNERGY_MAX_IMAGE_BYTES});
        }
        my $size = -s $file_or_directory;
        if ($max_bytes && $size > $max_bytes) {
            delete $already_in_context->{$file_or_directory};
            my $msg
              = qq[ERROR: image '$file_or_directory' is $size bytes, over the $max_bytes-byte limit (SYNERGY_MAX_IMAGE_BYTES raises it; 0 disables)];
            say $msg;
            push @$convo_aref, $msg if $agent_mode;
            return;
        }
        $output = qq[image: '$file_or_directory'];
    }
    elsif (-f $file_or_directory) {
        my $t = _file_context_text($file_or_directory);
        $output = qq[file: '$file_or_directory'\ncontents: $t];
    }
    else {
        $output = qq[file: '$file_or_directory':\ncontents: N/A];
    }
  PUSH_END:
    push @$context_aref, $output;
    push @$convo_aref,   qq[push: $file_or_directory];
    say qq[push: $file_or_directory];
    return;
}

sub drop_indices {
    my (%args)       = @_;
    my $context_aref = $args{context_aref};
    my $convo_aref   = $args{convo_aref};
    my $indices_aref = $args{indices_aref} // [];

    my @indices    = @$indices_aref;
    my $output_str = "";
    if (!@indices) {
        if (@$context_aref) {
            my $removed = pop @$context_aref;
            my $preview = substr($removed, 0, 60);
            $preview =~ s/\n/ /g;
            $output_str = qq{Dropped top element: $preview...};
            push @$convo_aref, qq[drop: $output_str];
            say $output_str;
        }
        else {
            $output_str = qq{Stack is empty, nothing to drop.};
            say $output_str;
        }
        return;
    }

    my @removed_previews;
    foreach my $idx (@indices) {
        if ($idx !~ /^\d+$/) {
            $output_str = qq{Invalid index: '$idx' (not a number)};
            say $output_str;
            next;
        }

        if ($idx >= 0 && $idx < scalar @$context_aref) {
            my $removed = splice(@$context_aref, $idx, 1);
            my $preview = substr($removed, 0, 60);
            $preview =~ s/\n/ /g;
            push @removed_previews, "[$idx]: $preview...";
        }
        else {
            $output_str = qq{Index out of range: $idx (valid range: 0-}
              . (scalar(@$context_aref) - 1) . qq{)};
            say $output_str;
        }
    }

    if (@removed_previews) {
        $output_str
          = "Dropped " . scalar(@removed_previews) . " element(s):\n";
        $output_str .= "  $_\n" for @removed_previews;
        chomp $output_str;
        push @$convo_aref, qq[drop: $output_str];
        say $output_str;
    }
    return;
}

sub list_stack {
    my (%args) = @_;
    my $context_aref = $args{context_aref};

    my $output = "";
    for (my $i = 0; $i < @$context_aref; $i++) {
        my $s = substr($context_aref->[$i], 0, 128 + 64);
        $s =~ s/\n/ /g;
        if ($i == @$context_aref - 1) {
            $output .= qq{ * [$i]: $s ...\n};
        }
        else {
            $output .= qq{   [$i]: $s ...\n};
        }
    }
    $output .= qq{[ ]} if scalar @$context_aref == 0;
    say $output;
    return;
}

sub peek {
    my (%args)       = @_;
    my $context_aref = $args{context_aref};
    my $i            = $args{index};

    if ($i > @$context_aref - 1 || $i < 0) {
        say
          qq[ERROR: ,peek tried to use a bad index into the context stack: $i];
        return;
    }
    if (scalar @$context_aref > 0) {
        my $output = qq[[$i]: ] . $context_aref->[$i];
        say $output;
    }
    return;
}

package Synergy::Agent;

use strict;
use warnings;
use feature        qw/ say state /;
use File::Basename qw(basename);
use Encode         qw(encode);
use Try::Tiny;

sub _context_stack_has_path {
    my (%args)       = @_;
    my $context_aref = $args{context_aref} // [];
    my $path         = $args{path}         // '';
    return 0 unless length $path;

    for my $entry (@$context_aref) {
        next unless defined $entry;
        if ($entry =~ /(?:^|\n)(?:file|directory): '\Q$path\E'/) {
            return 1;
        }
    }
    return 0;
}

sub _auto_push_agents_md {
    my (%args)                = @_;
    my $cwd                   = $args{cwd}                     // '.';
    my $context_aref          = $args{context_aref}            // [];
    my $convo_aref            = $args{convo_aref}              // [];
    my $already_in_context_hr = $args{already_in_context_href} // {};

    my $agents_md_path = $cwd . "/AGENTS.md";
    return unless -f $agents_md_path;

    if ($already_in_context_hr->{$agents_md_path}) {
        return;
    }
    if (
        _context_stack_has_path(
            context_aref => $context_aref,
            path         => $agents_md_path
        )
      )
    {
        $already_in_context_hr->{$agents_md_path} = 1;
        return;
    }

    Synergy::ContextStack::push_path(
        file_or_directory       => $agents_md_path,
        context_aref            => $context_aref,
        convo_aref              => $convo_aref,
        already_in_context_href => $already_in_context_hr,
        agent_mode              => 1,
    );
}

sub run_agent_loop {
    my (%args)           = @_;
    my $S                = $args{state} // {};
    my $task_description = $args{task_description};
    my $cmd_lookup       = $args{cmd_lookup};

    my $convo_aref              = $S->{convo_aref};
    my $context_aref            = $S->{context_aref};
    my $conv_sep_ref            = $S->{conv_sep_ref};
    my $base_system_prompt_ref  = $S->{base_system_prompt_ref};
    my $synergy_root_ref        = $S->{synergy_root_ref};
    my $cwd_ref                 = $S->{cwd_ref};
    my $provider_ref            = $S->{provider_ref};
    my $api_key_ref             = $S->{api_key_ref};
    my $model_config_ref        = $S->{model_config_ref};
    my $api_calls_ref           = $S->{api_calls_ref};
    my $max_retries_ref         = $S->{max_retries_ref};
    my $agent_mode_ref          = $S->{agent_mode_ref};
    my $sigint_recvd_ref        = $S->{sigint_recvd_ref};
    my $user_shell_prompt_ref   = $S->{user_shell_prompt_ref};
    my $already_in_context_href = $S->{already_in_context_href} // {};

    my $call_assistant_cb = $args{call_assistant_cb}
      // $S->{call_assistant_cb} // \&main::call_assistant;

    unless ($task_description) {
        say "ERROR: No task provided to ,agent";
        say "Usage: ,agent <task description>";
        return;
    }

    if (-p STDIN) {
        say "ERROR: Agent mode is not available in non-interactive mode";
        return;
    }

    _auto_push_agents_md(
        cwd                     => $$cwd_ref,
        context_aref            => $context_aref,
        convo_aref              => $convo_aref,
        already_in_context_href => $already_in_context_href,
    );

    # Record the user's `,agent <task>` command in the history. It
    # stays in agent requests too: history must remain byte-identical
    # across chat and agent modes so both share one cache prefix.
    push @$convo_aref, qq[agent: $task_description];

    $$agent_mode_ref = 1;
    my $saw_non_comment_action = 0;

    while ($$agent_mode_ref) {

        main::maybe_autocompact();
        Synergy::ContextStack::announce_stale_context(
            context_aref => $context_aref,
            convo_aref   => $convo_aref,
        );
        Synergy::ContextStack::announce_git_delta(convo_aref => $convo_aref,);

        # All agent-specific instructions ride in the final turn
        # message, after the history cache breakpoint. The system
        # prompt and the message prefix stay byte-identical with chat
        # mode, so entering agent mode extends the session's server-
        # side prompt cache instead of forking it; the re-sent tail
        # costs ~1k tokens per turn, far less than re-ingesting the
        # whole prefix on every mode switch.

        my ($success, $command) = main::call_assistant_with_retries(
            max_retries => $$max_retries_ref,
            log_prefix  => 'AGENT: ',
            attempt     => sub {
                my $agent_turn_prompt = <<"EOAGENTTURN";
MODE: AGENT

**OPERATIONAL GUIDELINES for SYNERGY Agent Mode:**

- The project's AGENTS.md file, if one exists, is already included in the file/context state; do not spend a command re-reading it.
- DO use the defined commands to explore local files that you need to complete your task
- DO use the `,apply_patch` command to write and edit files
- DO emit one `,exec` command per line; a command may be a `|` pipeline. No shell wrappers, wildcards, redirection, `;`, or `&&`.
- DO review the outputs of the previously run commands, they're in the conversation history.
- If a command is denied by the user or by policy, do not retry it or variations of it; choose a different approach or record the blocker with ,comment.
- If you are blocked on information or a decision only the user can provide, use ,ask <question>; the loop pauses for their answer and then continues. Do not guess.

---
**AVAILABLE COMMANDS:**
- @{[ Synergy::Util::agent_apply_patch_example(
        command_prefix => '- ',
        line_prefix    => '                        ',
    ) ]}
@{[ join "\n", map { "                        $_" } Synergy::Util::agent_apply_patch_prompt_details() ]}
- ,exec <cmd>       (Run a command or a '|' pipeline. Trusted commands run directly; git and unknown commands require user approval; destructive git operations, rm, and shell interpreters are blocked), e.g.,
                        - ,exec rg -n <pattern> <file.txt>
                        - ,exec rg -n <pattern> <file.txt> | head -20
                        - ,exec sed -n 100,120p <file.txt>
                        - ,exec ls
                        - ,exec git status --short
                        - ,exec jira-create-issue DOC "document the foo"
- ,ask <question>   (pause; the user is asked and their answer is added to the conversation)
- ,comment <text>   (record important context, blockers, or completion)

Working Directory: $$cwd_ref

Task:
$task_description

Decide the next useful agent action.

Rules for your response:
- Use ,exec and ,apply_patch command lines for actions.
- Bare prose is allowed for user-visible commentary, answers, reviews, and reports; it will be printed and saved as comment history.
- Do not wrap commands in markdown fences.
- Prefer action over narration.
- Use ,comment only when it records important context, a blocker, or completion.
- You may emit multiple command lines in one response when later commands do not depend on reading earlier command output.
- If you edit files, run a relevant check (usually an automated test) before completing when practical.
- If the task is complete, emit any needed user-visible final answer or report as bare prose, then finish with ,comment AGENT_COMPLETE.
- AGENT_COMPLETE is a private control marker and will not be printed; do not put a user-facing summary after it.
- Do not recap progress that is already visible unless the user explicitly asked for a summary, review, or report.
EOAGENTTURN

                my $messages = Synergy::Prompt::build_request_messages(
                    convo        => $convo_aref,
                    context      => $context_aref,
                    sep          => $$conv_sep_ref,
                    user_message => $agent_turn_prompt,
                    user_label   => 'Agent next turn',
                );
                my $reply = $call_assistant_cb->(
                    provider         => $$provider_ref,
                    api_key          => $$api_key_ref,
                    model            => $$model_config_ref->{model_name},
                    system_prompt    => $$base_system_prompt_ref,
                    messages         => $messages,
                    reasoning_effort => 'high',
                    anthropic_thinking_enabled => (
                        $$model_config_ref->{anthropic_supports_thinking}
                        ? 1
                        : 0
                    ),
                );
                $$api_calls_ref++;
                return $reply;
            },
        );
        unless ($success) {
            if (($command // '') =~ /^canceled:/) {

                # The SIGINT handler already left agent mode; a quiet
                # AGENT_COMPLETE ends the loop without a retry storm.
                $command = qq[AGENT_COMPLETE: request canceled by user];
            }
            else {
                $command
                  = qq[AGENT_COMPLETE: API call failed after $$max_retries_ref retries: $command];
                say STDERR qq[$command] unless -p STDIN;
                $$agent_mode_ref = undef;
            }
        }

        if ($command) {
            my $exec_result = execute_agent_command(
                state      => $S,
                command    => $command,
                cmd_lookup => $cmd_lookup,
            );
            $exec_result ||= {};

            if ($exec_result->{has_non_comment_action}) {
                $saw_non_comment_action = 1;
            }

            # Check for stop condition
            if ($exec_result->{has_agent_complete}) {
                if (!$saw_non_comment_action) {
                    my $msg
                      = "WARNING: agent completed without running any commands";
                    say $msg;
                    push @$convo_aref, $msg;
                }

                Synergy::Util::ring_terminal_bell(stdin_is_pipe => -p STDIN);
                $$agent_mode_ref = undef;
                last;
            }
        }
        else {
            say qq[WARNING: command was not defined! agent did not reply];
        }

        # Brief pause for UX (unless in fast mode)
        sleep 1 unless $ENV{SYNERGY_AGENT_FAST};

        # Check if user wants to interrupt
        if ($$sigint_recvd_ref) {
            $$sigint_recvd_ref = 0;
            my $response = main::prompted_read_line(
                "\nAGENT MODE: Interrupted by user. Continue agent? (y/n): ");
            chomp $response if defined $response;

            if (defined $response && lc($response) ne 'y') {
                say "AGENT MODE: Stopped by user.";
                last;
            }
            else {
                say "AGENT MODE: Continuing...";
            }
        }
    }
    print $$user_shell_prompt_ref unless main::using_readline();
    return;
}

sub _agent_action_summary {
    my (%args) = @_;
    my $name   = $args{name};
    my $raw    = defined $args{args} ? $args{args} : '';

    return if !defined $name  || $name eq 'comment';
    return if $name eq 'exec' || $name eq 'apply_patch';
    return if $name eq 'ask';    # handler prints 'agent asks:' itself

    return length $raw ? qq[agent: $name $raw] : qq[agent: $name];
}

sub _agent_log_info {
    my (%args)     = @_;
    my $msg        = $args{msg}        // '';
    my $convo_aref = $args{convo_aref} // [];
    my $logfile    = $args{logfile};

    return unless length $msg;

    say $msg;
    push @$convo_aref, $msg;
    Synergy::Util::append_to_log($logfile, $msg)
      if defined $logfile && length $logfile;
    return;
}

# Exact ,exec command lines the user answered 'a' (always) to at the
# approval prompt. In-memory only: never dumped, so a reloaded
# session starts with no standing approvals.
my %agent_session_approved_execs;

sub _agent_approve_exec {
    my (%args)     = @_;
    my $cmd        = $args{cmd}        // '';
    my $base_cmd   = $args{base_cmd}   // '';
    my $convo_aref = $args{convo_aref} // [];
    my $logfile    = $args{logfile};

    my $request_label = $base_cmd eq 'git' ? 'git' : 'command';
    my $prompt
      = $base_cmd eq 'git'
      ? "Allow this git command to run? [y/N/a] "
      : "Allow this command to run? [y/N/a] ";

    say qq[agent requests $request_label: $cmd];
    my $answer   = main::prompted_read_line($prompt);
    my $approved = 0;
    if (defined $answer) {
        chomp $answer;
        $answer =~ s/^\s+//;
        $answer =~ s/\s+$//;
        my $normalized = lc $answer;
        $approved = 1 if $normalized eq 'y' || $normalized eq 'yes';
        if ($normalized eq 'a' || $normalized eq 'always') {
            $approved = 1;
            $agent_session_approved_execs{$cmd} = 1;
            say qq[Approved for the rest of this session: $cmd];
        }
    }

    unless ($approved) {
        my $msg
          = $base_cmd eq 'git'
          ? "AGENT INFO: git command denied by user"
          : "AGENT INFO: command denied by user";
        _agent_log_info(
            msg        => $msg,
            convo_aref => $convo_aref,
            logfile    => $logfile,
        );
        return 0;
    }

    return 1;
}

sub execute_agent_command {
    my (%args)  = @_;
    my $S       = $args{state} // {};
    my $command = $args{command};

    my $cmd_lookup  = $args{cmd_lookup};
    my $convo_aref  = $S->{convo_aref};
    my $logfile_ref = $S->{logfile_ref};

    my $auto_dump_mode_ref   = $S->{auto_dump_mode_ref};
    my $active_dump_file_ref = $S->{active_dump_file_ref};

    my @actions = parse_agent_actions($command,);

    my $has_non_comment_action = 0;
    my $completion_summary;

    for my $action (@actions) {
        my $cmd_name = $action->{name};
        my $cmd_args = defined($action->{args}) ? $action->{args} : '';

        if ($cmd_name eq '__agent_error__') {
            say $cmd_args;
            push @$convo_aref, $cmd_args;
            next;
        }

        if (!exists $cmd_lookup->{$cmd_name}) {
            my $msg = "AGENT ERROR: Unknown command ',$cmd_name'";
            say $msg;
            push @$convo_aref, $msg;
            next;
        }

        my $summary
          = _agent_action_summary(name => $cmd_name, args => $cmd_args,);
        say $summary if defined $summary && length $summary;

        if ($cmd_name eq 'exec') {
            $has_non_comment_action = 1;
            my $parsed = Synergy::Exec::parse_exec_command(cmd => $cmd_args);
            if ($parsed && $parsed->{error}) {
                say $parsed->{error};
                push @$convo_aref, $parsed->{error};
                Synergy::Util::append_to_log($$logfile_ref, $parsed->{error})
                  if defined $$logfile_ref && length $$logfile_ref;
                next;
            }
            next unless $parsed;

            my ($policy, $deny_reason, $denied_cmd)
              = Synergy::Exec::pipeline_policy(
                segments => $parsed->{segments});

            if ($policy eq 'deny') {
                my $msg
                  = defined $deny_reason
                  ? "AGENT INFO: $deny_reason"
                  : "AGENT INFO: command denied by policy: $denied_cmd";
                _agent_log_info(
                    msg        => $msg,
                    convo_aref => $convo_aref,
                    logfile    => $$logfile_ref,
                );
                next;
            }

            if ($policy eq 'confirm') {
                if ($S->{agent_auto_approve_ref}
                    && ${$S->{agent_auto_approve_ref}})
                {
                    # yolo mode: skip the info line, user doesn't need it
                }
                elsif ($agent_session_approved_execs{$parsed->{full_cmd}}) {

                    # user answered 'a' to this exact command earlier
                }
                else {
                    next
                      unless _agent_approve_exec(
                        cmd        => $parsed->{full_cmd},
                        base_cmd   => $parsed->{policy_base_cmd},
                        convo_aref => $convo_aref,
                        logfile    => $$logfile_ref,
                      );
                }
            }

            $cmd_lookup->{$cmd_name}->($cmd_args, skip_policy => 1);
            next;
        }

        if (   !defined $completion_summary
            && $cmd_name eq 'comment'
            && $cmd_args =~ /^\s*AGENT_COMPLETE(?::(.*))?\s*$/s)
        {
            $completion_summary = defined($1) ? $1 : '';
        }

        $has_non_comment_action = 1 if $cmd_name ne 'comment';
        if (defined($cmd_args) && length($cmd_args)) {
            $cmd_lookup->{$cmd_name}->($cmd_args);
        }
        else {
            $cmd_lookup->{$cmd_name}->();
        }
    }

    my $has_agent_complete = defined($completion_summary) ? 1 : 0;

    # For agent mode, we no longer auto-dump on every command, since that
    # produces too many dump files and unnecessary I/O. Instead, the main
    # REPL loop maintains a single rolling per-session dump file, and we
    # optionally trigger an extra dump once when the agent reports
    # AGENT_COMPLETE so that long-running agent work is safely persisted.
    if ($has_agent_complete && $$auto_dump_mode_ref && $$active_dump_file_ref)
    {
        $cmd_lookup->{dump}->($$active_dump_file_ref);
    }

    return {
        has_non_comment_action => $has_non_comment_action ? 1 : 0,
        has_agent_complete     => $has_agent_complete,
        completion_summary     => $completion_summary,
    };
}

sub _agent_error_action {
    my ($msg) = @_;
    return {name => '__agent_error__', args => $msg,};
}

sub _agent_apply_patch_action {
    my (%args)  = @_;
    my $file    = $args{file};
    my $payload = $args{payload} // '';

    return {name => 'apply_patch', args => $file . ' ' . $payload,};
}

sub _agent_apply_patch_start {
    my (%args)          = @_;
    my $line            = $args{line} // '';
    my $left_marker_pat = $args{left_marker_pat};

    return
      unless $line
      =~ /^,apply_patch\s+(\S+)\s+('?)($left_marker_pat) ORIGINAL(.*)$/;

    return ($1, "$3 ORIGINAL$4\n");
}

sub parse_agent_actions {
    my ($text) = @_;

    my @actions;
    my $left_marker_pat  = '<' . Synergy::Util::patch_marker_bounds();
    my $right_marker_pat = '>' . Synergy::Util::patch_marker_bounds();

    # Line-oriented state machine. Commands must begin at start-of-line.
    # Agent mode uses the chevron diff-fenced apply_patch format:
    #   ,apply_patch file <<<<<< ORIGINAL
    #   ...
    # Command lines must begin at start-of-line.
    # Agent mode accepts a single hunk per ,apply_patch command.
    my $bytes = encode('UTF-8', $text // '');
    open my $sh, '<', \$bytes
      or die qq[can not open string handle on '$text': $!];

    my $apply_patch_file    = undef;
    my $apply_patch_payload = '';
    my $allow_extra_hunk    = 0;
    my $discard_extra_hunk  = 0;

    my $command_pat = qr[^,([a-zA-Z_]+)(?:\s+(.*))?$];

    my $line_no = 0;
    while (my $line = <$sh>) {
        $line_no++;
        if ($discard_extra_hunk) {
            if ($line =~ /^($right_marker_pat) UPDATED'?(?:\s.*)?$/) {
                $discard_extra_hunk = 0;
            }
            next;
        }

        if (!defined $apply_patch_file) {
            if (   $allow_extra_hunk
                && $line =~ /^$left_marker_pat ORIGINAL[ \t]*$/)
            {
                $discard_extra_hunk = 1;
                next;
            }

            my ($file, $payload) = _agent_apply_patch_start(
                line            => $line,
                left_marker_pat => $left_marker_pat,
            );
            if (defined $file) {
                $apply_patch_file    = $file;
                $apply_patch_payload = $payload;
                $allow_extra_hunk    = 0;
                next;
            }

            if ($line =~ /$command_pat/) {
                push @actions, {name => $1, args => ($2 // ''),};
                $allow_extra_hunk = 0;
            }
            elsif (@actions && $actions[-1]{name} eq 'comment') {
                $actions[-1]{args} .= "\n"
                  unless $actions[-1]{args} =~ /\n\z/;
                $actions[-1]{args} .= $line;
            }
            elsif ($line =~ /\S/) {
                chomp(my $comment = $line);
                push @actions, {name => 'comment', args => $comment,};
                $allow_extra_hunk = 0;
            }
            next;
        }

        # Tolerant terminator policy (agent mode): once a line starts with
        # the UPDATED marker (optionally quoted), treat the patch as complete
        # and ignore trailing characters on that same line.
        if ($line =~ /^($right_marker_pat) UPDATED'?(?:\s.*)?$/) {
            $apply_patch_payload .= "$1 UPDATED\n";
            push @actions,
              _agent_apply_patch_action(
                file    => $apply_patch_file,
                payload => $apply_patch_payload,
              );
            $apply_patch_file    = undef;
            $apply_patch_payload = '';
            $allow_extra_hunk    = 1;
            next;
        }

        $apply_patch_payload .= $line;
    }

    close $sh;

    if (defined $apply_patch_file) {
        push @actions,
          _agent_error_action(
            qq[AGENT ERROR: Incomplete ,apply_patch for '$apply_patch_file': missing '>>>>>> UPDATED' terminator]
          );
    }

    return @actions;
}

package Synergy::Commands;

use strict;
use warnings;
use feature     qw/ say /;
use File::Slurp qw/ slurp /;
use Time::HiRes qw/ time /;
use Try::Tiny;
use Text::ParseWords qw(shellwords);
use Encode           qw(encode);
use File::Spec;
use Cwd;

sub _codex_compaction_prompt {
    my (%args) = @_;
    my $synergy_root = $args{synergy_root};

    my $fallback = <<'EOF';
You are performing a CONTEXT CHECKPOINT COMPACTION. Create a handoff summary for another LLM that will resume the task.

Include:
- Current progress and key decisions made
- Important context, constraints, or user preferences
- What remains to be done (clear next steps)
- Any critical data, examples, or references needed to continue

Be concise, structured, and focused on helping the next LLM seamlessly continue the work.
EOF

    my @candidates;
    if (defined $synergy_root && length $synergy_root) {
        push @candidates,
          File::Spec->catfile($synergy_root, 'etc', 'notes',
            'codex-compaction-prompt.txt');
    }
    push @candidates,
      File::Spec->catfile('etc', 'notes', 'codex-compaction-prompt.txt');

    for my $path (@candidates) {
        next unless defined $path && -f $path;
        return slurp($path);
    }

    return $fallback;
}

sub run_collect {
    my (%args) = @_;

    my $convo_aref        = $args{convo_aref}   // [];
    my $context_aref      = $args{context_aref} // [];
    my $synergy_root      = $args{synergy_root};
    my $provider          = $args{provider} // '';
    my $api_key           = $args{api_key};
    my $model             = $args{model}    // '';
    my $conv_sep          = $args{conv_sep} // "\n===\n";
    my $logfile           = $args{logfile};
    my $call_assistant_cb = $args{call_assistant_cb};

    unless (@$convo_aref) {
        say "collect: nothing to collect";
        return;
    }

    my $system_prompt
      = _codex_compaction_prompt(synergy_root => $synergy_root);
    my $collect_user_message = <<"EOF";
Please compact the current conversation history and any relevant file/context state into a handoff summary that can replace the current conversation history.

Return only the handoff summary text.
EOF

    # The condition that triggers a compaction can also break it: the
    # summarization call itself may exceed the context window. On
    # failure, retry with the oldest quarter of the history dropped
    # from the compaction input only; the live history is untouched
    # until a summary is in hand.
    my @source = @$convo_aref;
    my $summary;
    my $attempts = 0;
    while (1) {
        my $messages = Synergy::Prompt::build_request_messages(
            convo        => \@source,
            context      => $context_aref,
            sep          => $conv_sep,
            user_message => $collect_user_message,
        );

        my $ok = eval {
            $summary = $call_assistant_cb->(
                provider                   => $provider,
                api_key                    => $api_key,
                model                      => $model,
                system_prompt              => $system_prompt,
                messages                   => $messages,
                reasoning_effort           => 'low',
                user_message               => $collect_user_message,
                anthropic_thinking_enabled => 0,
            );
            1;
        };
        last if $ok;

        chomp(my $error = $@ || 'unknown error');
        $attempts++;
        if ($error =~ /^canceled:/ || $attempts >= 3 || @source <= 1) {
            say "ERROR: ,collect failed: $error";
            return;
        }
        my $drop = int(@source / 4) || 1;
        splice(@source, 0, $drop);
        say "collect: retrying with the oldest $drop history"
          . " entries dropped";
    }

    $summary = '' unless defined $summary;
    $summary =~ s/\A\s+//;
    $summary =~ s/\s+\z//;

    # Keep the user's own recent words verbatim alongside the summary;
    # assistant replies and command output are left to the summary.
    # Prior summaries lack the 'USER > ' prefix, so they are never
    # re-harvested here.
    my @retained;
    my $budget = 16_000;
    for my $entry (reverse @$convo_aref) {
        next unless ($entry // '') =~ /^USER > /;
        last if length($entry) > $budget;
        push @retained, $entry;
        $budget -= length($entry);
    }

    @$convo_aref = (qq[COLLECTED CONTEXT:\n$summary], reverse @retained);
    my $note
      = "collect: conversation history compacted into a" . " handoff summary";
    Synergy::Util::append_to_log($logfile, $note)
      if defined $logfile && length $logfile;
    say $note;

    return;
}

sub build_cmd_lookup {
    my (%args) = @_;
    my $S = $args{state} // {};

    my $models_aref             = $S->{models_aref}             // [];
    my $session_token_usage_ref = $S->{session_token_usage_ref} // {};

    my $call_assistant_cb = $args{call_assistant_cb}
      // $S->{call_assistant_cb} // \&main::call_assistant;

    my $cmd_lookup;
    $cmd_lookup = {
        help => sub { print ${$S->{helptext_ref}}; },
        pwd  => sub {
            my $cwd         = ${$S->{cwd_ref}};
            my $actual_cwd  = getcwd;
            my @cwd_stat    = stat($cwd);
            my @actual_stat = stat($actual_cwd);
            my $same
              = @cwd_stat
              && @actual_stat
              && $cwd_stat[0] == $actual_stat[0]
              && $cwd_stat[1] == $actual_stat[1];
            if ($same) {
                my $output = qq[pwd: $cwd];
                say $output;
            }
            else {
                say
                  qq[Actual cwd '$actual_cwd' does not match expected cwd '$cwd'];
            }
        },
        cd => sub {
            my ($dir) = @_;
            if (${$S->{agent_mode_ref}}) {
                say qq[ERROR: Agents are not allowed to run ,cd];
                return;
            }
            return unless defined $dir;
            unless (-e -d $dir) {
                say qq[Directory '$dir' not found];
                return;
            }
            if (chdir($dir)) {
                ${$S->{cwd_ref}} = $dir;
                say qq[cwd set to: '${$S->{cwd_ref}}'];
            }
            else {
                say qq[Could not chdir to '$dir'];
            }
        },
        edit => sub {
            my ($file) = @_;
            if (${$S->{agent_mode_ref}}) {
                say qq[ERROR: Agents are not allowed to run ,edit];
                return;
            }
            unless (defined $file) {
                say qq[Usage: ,edit <file>];
                return;
            }
            $file =~ s/^\s+|\s+$//g;
            unless (length $file) {
                say qq[Usage: ,edit <file>];
                return;
            }
            my $editor = $ENV{EDITOR};
            unless (defined $editor && $editor =~ /\S/) {
                say qq[ERROR: EDITOR is not set];
                return;
            }
            my @argv = shellwords($editor);
            unless (@argv) {
                say qq[ERROR: EDITOR is not set];
                return;
            }
            my $status = system {$argv[0]} @argv, $file;
            if ($status == -1) {
                say qq[ERROR: Failed to launch editor '$argv[0]': $!];
                return;
            }
            if ($status != 0) {
                say qq[ERROR: Editor exited with status ] . ($status >> 8);
                return;
            }
            my $history_entry = qq[edit: $file];
            push @{$S->{convo_aref}}, $history_entry;
            my $logfile = ${$S->{logfile_ref}};
            Synergy::Util::append_to_log($logfile, $history_entry)
              if defined $logfile && length $logfile;
            say qq[edit: opened '$file'];
        },
        model => sub {
            my ($new_model_short_name) = @_;
            my $model_config_ref       = $S->{model_config_ref};
            my $model_short_name_ref   = $S->{model_short_name_ref};
            my $provider_ref           = $S->{provider_ref};
            my $api_key_ref            = $S->{api_key_ref};
            if (!defined $new_model_short_name) {
                my $output
                  = qq[Model: '$$model_short_name_ref' (`$$model_config_ref->{model_name}`)];
                say $output;
            }
            else {
                $new_model_short_name =~ s/ //g;
                my $found_model;
                for my $model_def (@$models_aref) {
                    if ($model_def->{short_name} eq $new_model_short_name) {
                        $found_model = $model_def;
                        last;
                    }
                }

                if ($found_model) {
                    $$model_config_ref     = $found_model;
                    $$model_short_name_ref = $found_model->{short_name};
                    $$provider_ref         = $$model_config_ref->{provider};
                    $$api_key_ref          = $ENV{$found_model->{env_var}};
                    say
                      qq[Switched model to '$$model_short_name_ref' (`$$model_config_ref->{model_name}`).];
                }
                else {
                    say
                      qq[ERROR: Model shortname '$new_model_short_name' not found.];
                }
            }
            say qq[Available models:];
            for my $model_def (@$models_aref) {
                my $indicator
                  = ($model_def->{short_name} eq $$model_short_name_ref)
                  ? '*'
                  : ' ';
                say
                  qq[  $indicator $model_def->{short_name} (`$model_def->{model_name}`)];
            }
        },
        yolo => sub {
            my $agent_auto_approve_ref = $S->{agent_auto_approve_ref};
            $$agent_auto_approve_ref = $$agent_auto_approve_ref ? 0 : 1;
            my $status = $$agent_auto_approve_ref ? 'ON' : 'OFF';
            say qq[Agent auto-approve mode: $status];
            if ($$agent_auto_approve_ref) {
                say
                  qq[  git, perl, and unknown commands will run without prompting.];
                say qq[  Destructive commands (rm, sh, etc.) remain blocked.];
            }
        },
        sid => sub {
            my $session_id_ref = $S->{session_id_ref};
            my $output         = qq[Session ID: $$session_id_ref];
            say $output;
        },
        tokens => sub {
            my $input_tokens  = $session_token_usage_ref->{input_tokens} // 0;
            my $output_tokens = $session_token_usage_ref->{output_tokens}
              // 0;
            my $total_tokens  = $session_token_usage_ref->{total_tokens};
            my $cached_tokens = $session_token_usage_ref->{cached_tokens}
              // 0;

            $total_tokens = $input_tokens + $output_tokens
              unless defined $total_tokens;

            my $pct
              = $input_tokens > 0
              ? sprintf("%.1f", ($cached_tokens / $input_tokens) * 100)
              : sprintf("%.1f", 0);

            say
              qq[tokens: input=$input_tokens output=$output_tokens total=$total_tokens cached=$cached_tokens cache_hit_pct=$pct%];
        },
        push => sub {
            my $file_or_directory = shift;
            Synergy::ContextStack::push_path(
                file_or_directory       => $file_or_directory,
                context_aref            => $S->{context_aref},
                convo_aref              => $S->{convo_aref},
                already_in_context_href => $S->{already_in_context_href},
                agent_mode              => ${$S->{agent_mode_ref}},
            );
        },
        drop => sub {
            my (@indices) = @_;
            Synergy::ContextStack::drop_indices(
                context_aref => $S->{context_aref},
                convo_aref   => $S->{convo_aref},
                indices_aref => \@indices,
            );
        },
        s => sub {
            Synergy::ContextStack::list_stack(
                context_aref => $S->{context_aref});
        },
        history => sub {
            my $convo_aref = $S->{convo_aref};
            my $buf        = '';
            for (my $i = 0; $i < @$convo_aref; $i++) {
                my $elem = $convo_aref->[$i];
                $buf .= qq{  [$i]: $elem\n};
            }
            Synergy::Util::print_or_page(
                text       => $buf,
                agent_mode => ${$S->{agent_mode_ref}},
            );
        },
        collect => sub {
            run_collect(
                convo_aref        => $S->{convo_aref},
                context_aref      => $S->{context_aref},
                synergy_root      => ${$S->{synergy_root_ref}},
                provider          => ${$S->{provider_ref}},
                api_key           => ${$S->{api_key_ref}},
                model             => ${$S->{model_config_ref}}->{model_name},
                conv_sep          => ${$S->{conv_sep_ref}},
                logfile           => ${$S->{logfile_ref}},
                call_assistant_cb => $call_assistant_cb,
            );
        },
        exit => sub {
            my $auto_dump_mode_ref   = $S->{auto_dump_mode_ref};
            my $active_dump_file_ref = $S->{active_dump_file_ref};
            my $dump_dir_ref         = $S->{dump_dir_ref};
            my $session_id_ref       = $S->{session_id_ref};

            if ($$auto_dump_mode_ref) {
                if (!$$active_dump_file_ref) {
                    my $next_ts   = time;
                    my $next_name = qq[dump-$$session_id_ref-$next_ts.xml];

                    my $maybe_dump_dir = $$dump_dir_ref;
                    $$active_dump_file_ref
                      = (-e -d $maybe_dump_dir)
                      ? qq[$maybe_dump_dir/$next_name]
                      : $next_name;
                }

                $cmd_lookup->{dump}->($$active_dump_file_ref);
            }

            print "Goodbye!\n";
            exit 0;
        },
        peek => sub {
            my $i = shift;
            Synergy::ContextStack::peek(
                context_aref => $S->{context_aref},
                index        => $i
            );
        },
        reset => sub {
            my ($arg)                   = @_;
            my $already_in_context_href = $S->{already_in_context_href};
            my $convo_aref              = $S->{convo_aref};
            my $context_aref            = $S->{context_aref};

            if (defined $arg) {
                $arg =~ s/^\s+|\s+$//g;

                if ($arg eq '') {
                    %$already_in_context_href = ();
                    @$convo_aref              = ();
                    @$context_aref            = ();
                    say "reset: cleared chat history and file context";
                    return;
                }

                unless ($arg =~ /\A[0-9]+\z/) {
                    say
                      "ERROR: Usage: ,reset [N] where N is a 0-based integer index into history";
                    return;
                }

                my $N   = int($arg);
                my $max = $#$convo_aref;
                if ($N < 0 || $N > $max) {
                    say "ERROR: ,reset N out of range: $N (valid: 0..$max)";
                    return;
                }

                splice(@$convo_aref, $N + 1);
                %$already_in_context_href = ();
                say
                  "reset: truncated chat history to [0..$N]; preserved file context";
                return;
            }

            %$already_in_context_href = ();
            @$convo_aref              = ();
            @$context_aref            = ();
            say "reset: cleared chat history and file context";
        },
        dump => sub {
            my ($filename) = @_;

            my $active_dump_file = ${$S->{active_dump_file_ref}};
            ($filename, $active_dump_file)
              = Synergy::SessionStore::dump_session(
                filename         => $filename,
                dump_dir         => ${$S->{dump_dir_ref}},
                session_id       => ${$S->{session_id_ref}},
                model            => ${$S->{model_short_name_ref}},
                system_prompt    => ${$S->{system_prompt_ref}},
                convo            => $S->{convo_aref},
                context          => $S->{context_aref},
                token_usage      => $session_token_usage_ref,
                auto_dump_mode   => ${$S->{auto_dump_mode_ref}},
                active_dump_file => $active_dump_file,
              );
            ${$S->{active_dump_file_ref}} = $active_dump_file;
        },
        load => sub {
            my ($filename) = @_;

            my $active_dump_file_ref = $S->{active_dump_file_ref};
            my $auto_dump_mode_ref   = $S->{auto_dump_mode_ref};
            my $log_dir_ref          = $S->{log_dir_ref};
            my $logfile_ref          = $S->{logfile_ref};
            my $session_id_ref       = $S->{session_id_ref};
            my $system_prompt_ref    = $S->{system_prompt_ref};

            my $active_dump_file = $$active_dump_file_ref;
            my ($session_id, $system_prompt, undef, undef,
                $new_active_dump_file, $dump_model)
              = Synergy::SessionStore::load_session(
                filename         => $filename,
                auto_dump_mode   => $$auto_dump_mode_ref,
                active_dump_file => $active_dump_file,
                session_id       => $$session_id_ref,
                system_prompt    => $$system_prompt_ref,
                convo            => $S->{convo_aref},
                context          => $S->{context_aref},
                token_usage      => $session_token_usage_ref,
              );

            $$session_id_ref       = $session_id;
            $$system_prompt_ref    = $system_prompt;
            $$active_dump_file_ref = $new_active_dump_file;
            $$logfile_ref = qq[$$log_dir_ref/chats-$$session_id_ref.txt];

            # Switch back to the model the dump was made with, so the
            # reloaded session lines up with its server-side prompt
            # cache. The user can still ,model away afterward.
            my $current_short_name = ${$S->{model_short_name_ref}};
            return
              if !defined($dump_model) || $dump_model eq $current_short_name;
            my ($found)
              = grep { $_->{short_name} eq $dump_model } @$models_aref;
            if ($found) {
                ${$S->{model_config_ref}}     = $found;
                ${$S->{model_short_name_ref}} = $found->{short_name};
                ${$S->{provider_ref}}         = $found->{provider};
                ${$S->{api_key_ref}}          = $ENV{$found->{env_var}};
                say
                  qq[Switched model to '$found->{short_name}' (`$found->{model_name}`).];
            }
            else {
                say
                  qq[WARNING: Dump was made with unknown model '$dump_model'; keeping '$current_short_name'.];
            }
        },
        exec => sub {
            my ($cmd, %opts) = @_;
            Synergy::Exec::run_exec(
                cmd        => $cmd,
                convo_aref => $S->{convo_aref},
                agent_mode => ${$S->{agent_mode_ref}},
                logfile    => ${$S->{logfile_ref}},
                %opts,
            );
        },
        ask => sub {
            my ($question) = @_;
            my $logfile_ref = $S->{logfile_ref};

            unless (${$S->{agent_mode_ref}}) {
                say
                  q[ERROR: ,ask pauses an agent for the user's answer; outside agent mode just type your question];
                return;
            }

            my $entry;
            if (!defined $question || $question !~ /\S/) {
                $entry = q[AGENT ERROR: ,ask requires a question];
                say $entry;
            }
            else {
                say qq[agent asks: $question];
                my $answer = main::prompted_read_line(q[your reply: ]);
                $answer = '' unless defined $answer;
                chomp $answer;
                $answer =~ s/^\s+|\s+$//g;
                $entry = qq[AGENT QUESTION: $question\nUSER ANSWER: ]
                  . ($answer =~ /\S/ ? $answer : q[(none given)]);
            }
            push @{$S->{convo_aref}}, $entry;
            Synergy::Util::append_to_log($$logfile_ref, $entry)
              if defined $$logfile_ref && length $$logfile_ref;
        },
        comment => sub {
            my ($comment) = @_;
            if ($comment) {
                if ($comment =~ /^\s*AGENT_COMPLETE(?:\b|:)/) {
                    Synergy::Util::append_to_log(${$S->{logfile_ref}},
                        qq[comment: $comment]);
                    return;
                }

                my $output = qq[comment: $comment];
                push @{$S->{convo_aref}}, $output;
                Synergy::Util::append_to_log(${$S->{logfile_ref}}, $output);
                say $comment;
            }
            return;
        },
        apply_patch => sub {
            my ($raw_args) = @_;
            Synergy::Patch::apply_patch(
                raw_args   => $raw_args,
                cwd        => ${$S->{cwd_ref}},
                convo_aref => $S->{convo_aref},
                agent_mode => ${$S->{agent_mode_ref}},
                logfile    => ${$S->{logfile_ref}},
            );
        },
        agent => sub {
            my ($task_description) = @_;
            Synergy::Agent::run_agent_loop(
                state             => $S,
                task_description  => $task_description,
                cmd_lookup        => $cmd_lookup,
                call_assistant_cb => $call_assistant_cb,
            );
        },
    };

    return $cmd_lookup;
}

